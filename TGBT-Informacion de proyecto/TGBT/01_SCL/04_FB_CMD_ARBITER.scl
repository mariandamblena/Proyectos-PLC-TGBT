FUNCTION_BLOCK "04_FB_CMD_ARBITER"
{ S7_Optimized_Access := 'TRUE' }
// ============================================================================
// FB: 04_FB_CMD_ARBITER  -- Arbitro de Comandos  V4.0
// ============================================================================
// CAMBIO ALCANCE V4:
//   - Eliminar feeder arrays (feeders manuales, sin logica PLC)
//   - Eliminar QT1_STATE/QG1_STATE/QG2_STATE (Int) -> usar CLOSED Bool
//   - Agregar Q22 (REQ_SCMTA, REQ_MAN, CMD, Q22_REMOTE_ALLOWED)
//   - Interlock usa CLOSED directamente (no comparacion con Int)
// ============================================================================
VERSION : 0.1
   VAR_INPUT
      // SCMTA requests (prioridad 1 en AUTO)
      REQ_SCMTA_OPEN_QT1  : Bool;
      REQ_SCMTA_CLOSE_QT1 : Bool;
      REQ_SCMTA_OPEN_QG1  : Bool;
      REQ_SCMTA_CLOSE_QG1 : Bool;
      REQ_SCMTA_OPEN_QG2  : Bool;
      REQ_SCMTA_CLOSE_QG2 : Bool;
      REQ_SCMTA_OPEN_Q22  : Bool;
      REQ_SCMTA_CLOSE_Q22 : Bool;

      // Manual requests (desde HMI / DB_GLOBAL_STATUS)
      REQ_MAN_QT1_OPEN    : Bool;
      REQ_MAN_QT1_CLOSE   : Bool;
      REQ_MAN_QG1_OPEN    : Bool;
      REQ_MAN_QG1_CLOSE   : Bool;
      REQ_MAN_QG2_OPEN    : Bool;
      REQ_MAN_QG2_CLOSE   : Bool;
      REQ_MAN_Q22_OPEN    : Bool;
      REQ_MAN_Q22_CLOSE   : Bool;

      MODE_AUTO           : Bool;
      MODE_MANUAL         : Bool;

      // Posicion (Bool) y REMOTO de cada interruptor
      QT1_CLOSED          : Bool;
      QG1_CLOSED          : Bool;
      QG2_CLOSED          : Bool;
      QT1_REMOTE          : Bool;
      QG1_REMOTE          : Bool;
      QG2_REMOTE          : Bool;
      Q22_REMOTE          : Bool;
   END_VAR

   VAR_OUTPUT
      CMD_OPEN_QT1        : Bool;
      CMD_CLOSE_QT1       : Bool;
      CMD_OPEN_QG1        : Bool;
      CMD_CLOSE_QG1       : Bool;
      CMD_OPEN_QG2        : Bool;
      CMD_CLOSE_QG2       : Bool;
      CMD_OPEN_Q22        : Bool;
      CMD_CLOSE_Q22       : Bool;
      BLOCK_LOCAL         : Bool;
      BLOCK_INTERLOCK     : Bool;
      BLOCK_CONFLICT      : Bool;
      ALM_INTERLOCK_VIOLATION : Bool;
      DIAG_CMD_SOURCE     : String[10];
   END_VAR

   VAR
      reqOpenQT1  : Bool;
      reqCloseQT1 : Bool;
      reqOpenQG1  : Bool;
      reqCloseQG1 : Bool;
      reqOpenQG2  : Bool;
      reqCloseQG2 : Bool;
      reqOpenQ22  : Bool;
      reqCloseQ22 : Bool;
      interlockOkCloseQT1 : Bool;
      interlockOkCloseQG1 : Bool;
      interlockOkCloseQG2 : Bool;
      multipleSourcesClosed : Bool;
   END_VAR


BEGIN
    // ========================================================================
    // NETWORK 1: RESET COMANDOS (1 scan pulse)
    // ========================================================================
    #CMD_OPEN_QT1  := FALSE; #CMD_CLOSE_QT1  := FALSE;
    #CMD_OPEN_QG1  := FALSE; #CMD_CLOSE_QG1  := FALSE;
    #CMD_OPEN_QG2  := FALSE; #CMD_CLOSE_QG2  := FALSE;
    #CMD_OPEN_Q22  := FALSE; #CMD_CLOSE_Q22  := FALSE;
    #BLOCK_LOCAL      := FALSE;
    #BLOCK_INTERLOCK  := FALSE;
    #BLOCK_CONFLICT   := FALSE;
    #DIAG_CMD_SOURCE  := '';


    // ========================================================================
    // NETWORK 2: PRIORIZACION (SCMTA AUTO > MANUAL)
    // ========================================================================
    IF #MODE_AUTO THEN
        #reqOpenQT1  := #REQ_SCMTA_OPEN_QT1;
        #reqCloseQT1 := #REQ_SCMTA_CLOSE_QT1;
        #reqOpenQG1  := #REQ_SCMTA_OPEN_QG1;
        #reqCloseQG1 := #REQ_SCMTA_CLOSE_QG1;
        #reqOpenQG2  := #REQ_SCMTA_OPEN_QG2;
        #reqCloseQG2 := #REQ_SCMTA_CLOSE_QG2;
        #reqOpenQ22  := #REQ_SCMTA_OPEN_Q22;
        #reqCloseQ22 := #REQ_SCMTA_CLOSE_Q22;
        IF #reqOpenQT1 OR #reqCloseQT1 OR #reqOpenQG1 OR #reqCloseQG1 OR
           #reqOpenQG2 OR #reqCloseQG2 OR #reqOpenQ22 OR #reqCloseQ22 THEN
            #DIAG_CMD_SOURCE := 'SCMTA';
        END_IF;

    ELSIF #MODE_MANUAL THEN
        #reqOpenQT1  := #REQ_MAN_QT1_OPEN;
        #reqCloseQT1 := #REQ_MAN_QT1_CLOSE;
        #reqOpenQG1  := #REQ_MAN_QG1_OPEN;
        #reqCloseQG1 := #REQ_MAN_QG1_CLOSE;
        #reqOpenQG2  := #REQ_MAN_QG2_OPEN;
        #reqCloseQG2 := #REQ_MAN_QG2_CLOSE;
        #reqOpenQ22  := #REQ_MAN_Q22_OPEN;
        #reqCloseQ22 := #REQ_MAN_Q22_CLOSE;
        IF #reqOpenQT1 OR #reqCloseQT1 OR #reqOpenQG1 OR #reqCloseQG1 OR
           #reqOpenQG2 OR #reqCloseQG2 OR #reqOpenQ22 OR #reqCloseQ22 THEN
            #DIAG_CMD_SOURCE := 'MANUAL';
        END_IF;

    ELSE
        #reqOpenQT1  := FALSE; #reqCloseQT1 := FALSE;
        #reqOpenQG1  := FALSE; #reqCloseQG1 := FALSE;
        #reqOpenQG2  := FALSE; #reqCloseQG2 := FALSE;
        #reqOpenQ22  := FALSE; #reqCloseQ22 := FALSE;
    END_IF;


    // ========================================================================
    // NETWORK 3: ENCLAVAMIENTO FUENTE UNICA
    // ========================================================================
    // Antes de cerrar QT1: QG1 y QG2 deben estar abiertos
    #interlockOkCloseQT1 := NOT #QG1_CLOSED AND NOT #QG2_CLOSED;

    // Antes de cerrar QG1: QT1 y QG2 deben estar abiertos
    #interlockOkCloseQG1 := NOT #QT1_CLOSED AND NOT #QG2_CLOSED;

    // Antes de cerrar QG2: QT1 y QG1 deben estar abiertos
    #interlockOkCloseQG2 := NOT #QT1_CLOSED AND NOT #QG1_CLOSED;

    // Deteccion de violacion (multiples fuentes cerradas simultaneamente)
    #multipleSourcesClosed := (#QT1_CLOSED AND #QG1_CLOSED) OR
                               (#QT1_CLOSED AND #QG2_CLOSED) OR
                               (#QG1_CLOSED AND #QG2_CLOSED);
    #ALM_INTERLOCK_VIOLATION := #multipleSourcesClosed;


    // ========================================================================
    // NETWORK 4: BLOQUEO LOCAL/REMOTO
    // ========================================================================
    IF (#reqOpenQT1 OR #reqCloseQT1) AND NOT #QT1_REMOTE THEN
        #reqOpenQT1 := FALSE; #reqCloseQT1 := FALSE; #BLOCK_LOCAL := TRUE;
    END_IF;
    IF (#reqOpenQG1 OR #reqCloseQG1) AND NOT #QG1_REMOTE THEN
        #reqOpenQG1 := FALSE; #reqCloseQG1 := FALSE; #BLOCK_LOCAL := TRUE;
    END_IF;
    IF (#reqOpenQG2 OR #reqCloseQG2) AND NOT #QG2_REMOTE THEN
        #reqOpenQG2 := FALSE; #reqCloseQG2 := FALSE; #BLOCK_LOCAL := TRUE;
    END_IF;
    IF (#reqOpenQ22 OR #reqCloseQ22) AND NOT #Q22_REMOTE THEN
        #reqOpenQ22 := FALSE; #reqCloseQ22 := FALSE; #BLOCK_LOCAL := TRUE;
    END_IF;


    // ========================================================================
    // NETWORK 5: BLOQUEO CONFLICTO OPEN+CLOSE SIMULTANEO
    // ========================================================================
    IF #reqOpenQT1 AND #reqCloseQT1 THEN
        #reqOpenQT1 := FALSE; #reqCloseQT1 := FALSE; #BLOCK_CONFLICT := TRUE;
    END_IF;
    IF #reqOpenQG1 AND #reqCloseQG1 THEN
        #reqOpenQG1 := FALSE; #reqCloseQG1 := FALSE; #BLOCK_CONFLICT := TRUE;
    END_IF;
    IF #reqOpenQG2 AND #reqCloseQG2 THEN
        #reqOpenQG2 := FALSE; #reqCloseQG2 := FALSE; #BLOCK_CONFLICT := TRUE;
    END_IF;
    IF #reqOpenQ22 AND #reqCloseQ22 THEN
        #reqOpenQ22 := FALSE; #reqCloseQ22 := FALSE; #BLOCK_CONFLICT := TRUE;
    END_IF;


    // ========================================================================
    // NETWORK 6: GENERAR COMANDOS FINALES (con enclavamiento)
    // ========================================================================
    // QT1 Open (siempre permitido si llego hasta aqui)
    IF #reqOpenQT1 THEN #CMD_OPEN_QT1 := TRUE; END_IF;
    IF #reqCloseQT1 THEN
        IF #interlockOkCloseQT1 THEN
            #CMD_CLOSE_QT1 := TRUE;
        ELSE
            #BLOCK_INTERLOCK := TRUE;
        END_IF;
    END_IF;

    IF #reqOpenQG1 THEN #CMD_OPEN_QG1 := TRUE; END_IF;
    IF #reqCloseQG1 THEN
        IF #interlockOkCloseQG1 THEN
            #CMD_CLOSE_QG1 := TRUE;
        ELSE
            #BLOCK_INTERLOCK := TRUE;
        END_IF;
    END_IF;

    IF #reqOpenQG2 THEN #CMD_OPEN_QG2 := TRUE; END_IF;
    IF #reqCloseQG2 THEN
        IF #interlockOkCloseQG2 THEN
            #CMD_CLOSE_QG2 := TRUE;
        ELSE
            #BLOCK_INTERLOCK := TRUE;
        END_IF;
    END_IF;

    // Q22: sin enclavamiento de fuente unica (derivacion independiente)
    IF #reqOpenQ22  THEN #CMD_OPEN_Q22  := TRUE; END_IF;
    IF #reqCloseQ22 THEN #CMD_CLOSE_Q22 := TRUE; END_IF;

END_FUNCTION_BLOCK
