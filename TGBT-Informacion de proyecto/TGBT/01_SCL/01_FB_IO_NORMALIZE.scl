FUNCTION_BLOCK "01_FB_IO_NORMALIZE"
{ S7_Optimized_Access := 'TRUE' }
// ============================================================================
// FB: 01_FB_IO_NORMALIZE  -- Normalizacion E/S Digitales  V4.0
// ============================================================================
// CAMBIO ALCANCE V4: Eliminados pushbuttons y arrays feeder.
// Control interruptores via HMI/SCMTA unicamente.
// Modbus solo PM5350P (lectura). OPEN = NOT CLOSED (sin DI separada).
// ============================================================================
VERSION : 0.1
   VAR_INPUT
      DI_SYS_AUTO       : Bool;   // TRUE = AUTO (fisico o bit DB HMI)

      // QT1 (interruptor RED)
      DI_QT1_REMOTE     : Bool;   // %I0.0 selector REMOTO
      DI_QT1_CLOSE      : Bool;   // %I0.1 posicion CERRADO
      DI_QT1_FAULT      : Bool;   // %I0.2 falla/disparado
      DI_QT1_UV_OV      : Bool;   // %I0.3 UV/OV backup DO PM5350P C02

      DI_BUSBAR_UV_OV   : Bool;   // %I0.4 UV/OV busbar (indicador)

      // QG1 (interruptor GD1)
      DI_QG1_REMOTE     : Bool;   // %I0.5 selector REMOTO
      DI_QG1_CLOSE      : Bool;   // %I0.6 posicion CERRADO
      DI_QG1_FAULT      : Bool;   // %I0.7 falla/disparado
      DI_QG1_UV_OV      : Bool;   // %I1.0 UV/OV backup DO PM5350P C01-GD1

      // QG2 (interruptor GD2 -- ENABLE_QG2=FALSE en V4)
      DI_QG2_REMOTE     : Bool;   // %I1.1 selector REMOTO
      DI_QG2_CLOSE      : Bool;   // %I1.2 posicion CERRADO
      DI_QG2_FAULT      : Bool;   // %I1.3 falla/disparado
      DI_QG2_UV_OV      : Bool;   // %I1.4 UV/OV backup DO PM5350P C01-GD2

      // Q22 (C06)
      DI_Q22_REMOTE     : Bool;   // %I8.5
   END_VAR

   VAR_OUTPUT
      MODE_AUTO         : Bool;
      MODE_MANUAL       : Bool;
      DIAG_MODE_VALID   : Bool;

      QT1_CLOSED        : Bool;
      QT1_OPEN          : Bool;
      QT1_FAULT         : Bool;
      QT1_REMOTE        : Bool;
      QT1_UV_OV_DI      : Bool;

      BUSBAR_UV_OV_DI   : Bool;

      QG1_CLOSED        : Bool;
      QG1_OPEN          : Bool;
      QG1_FAULT         : Bool;
      QG1_REMOTE        : Bool;
      QG1_UV_OV_DI      : Bool;

      QG2_CLOSED        : Bool;
      QG2_OPEN          : Bool;
      QG2_FAULT         : Bool;
      QG2_REMOTE        : Bool;
      QG2_UV_OV_DI      : Bool;

      Q22_REMOTE        : Bool;
   END_VAR

   VAR_TEMP
      dummy : Bool;
   END_VAR


BEGIN
    // NETWORK 1: MODO AUTO / MANUAL
    #MODE_AUTO       := #DI_SYS_AUTO;
    #MODE_MANUAL     := NOT #DI_SYS_AUTO;
    #DIAG_MODE_VALID := TRUE;

    // NETWORK 2: QT1 (RED)
    #QT1_CLOSED   := #DI_QT1_CLOSE;
    #QT1_OPEN     := NOT #DI_QT1_CLOSE;
    #QT1_FAULT    := #DI_QT1_FAULT;
    #QT1_REMOTE   := #DI_QT1_REMOTE;
    #QT1_UV_OV_DI := #DI_QT1_UV_OV;

    // NETWORK 3: BUSBAR
    #BUSBAR_UV_OV_DI := #DI_BUSBAR_UV_OV;

    // NETWORK 4: QG1 (GD1)
    #QG1_CLOSED   := #DI_QG1_CLOSE;
    #QG1_OPEN     := NOT #DI_QG1_CLOSE;
    #QG1_FAULT    := #DI_QG1_FAULT;
    #QG1_REMOTE   := #DI_QG1_REMOTE;
    #QG1_UV_OV_DI := #DI_QG1_UV_OV;

    // NETWORK 5: QG2 (GD2) -- ENABLE_QG2=FALSE en V4
    #QG2_CLOSED   := #DI_QG2_CLOSE;
    #QG2_OPEN     := NOT #DI_QG2_CLOSE;
    #QG2_FAULT    := #DI_QG2_FAULT;
    #QG2_REMOTE   := #DI_QG2_REMOTE;
    #QG2_UV_OV_DI := #DI_QG2_UV_OV;

   // NETWORK 6: Q22 REMOTO (%I8.5)
    #Q22_REMOTE := #DI_Q22_REMOTE;

END_FUNCTION_BLOCK


