(*
================================================================================
  FUNCTION BLOCK: FB_IO_NORMALIZE
  Versión: 2.0
  Fecha: 2026-02-10
  Autor: Sistema SCMTA TGBT
================================================================================
  DESCRIPCIÓN:
  Normaliza las entradas físicas del sistema (selectores Local/Remoto, 
  pulsadores Open/Close, selector Auto/Manual) a señales lógicas internas.
  
  RESPONSABILIDADES:
  1. Conversión de selector AUTO/MANUAL → MODE_AUTO / MODE_MANUAL
  2. Interpretación de selectores LOCAL/REMOTO → *_REMOTE_ALLOWED
  3. Detección de flancos en pulsadores Open/Close → REQ_MAN_* (pulsos 1 scan)
  4. Validación básica de consistencia de señales
  
  SEGURIDAD:
  - Si selector AUTO está indefinido → DEFAULT a MANUAL (fail-safe)
  - Pulsadores se filtran por debounce de 50ms
  
================================================================================
*)

FUNCTION_BLOCK "FB_IO_NORMALIZE"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

VAR_INPUT 
    // ===== ===== ENTRADAS FÍSICAS (DI) ==========
    // Selector Auto/Manual del sistema
    DI_SYS_AUTO : Bool;             // TRUE = Auto, FALSE = Manual
    
    // QT1 - Interruptor de RED
    DI_QT1_REMOTE_SEL : Bool;       // TRUE = Remoto (PLC control), FALSE = Local
    DI_QT1_PB_OPEN : Bool;          // Pulsador Open (NA, 24VDC)
    DI_QT1_PB_CLOSE : Bool;         // Pulsador Close (NA, 24VDC)
    
    // QG1 - Interruptor GD01
    DI_QG1_REMOTE_SEL : Bool;
    DI_QG1_PB_OPEN : Bool;
    DI_QG1_PB_CLOSE : Bool;
    
    // QG2 - Interruptor GD02 (futuro)
    DI_QG2_REMOTE_SEL : Bool;
    DI_QG2_PB_OPEN : Bool;
    DI_QG2_PB_CLOSE : Bool;
    
    // Grupo Diésel 1 - señales estado
    DI_GD_READY : Bool;             // GD1 listo para transferir (contacto auxiliar)
    DI_GD_RUNNING : Bool;           // GD1 en marcha
    DI_GD_ALARM : Bool;             // GD1 en alarma/falla
    
    // Grupo Diésel 2 - señales estado (redundancia N+1)
    DI_GD2_READY : Bool;            // GD2 listo para transferir
    DI_GD2_RUNNING : Bool;          // GD2 en marcha
    DI_GD2_ALARM : Bool;            // GD2 en alarma/falla
    
    // Feeders (19 NSX con Modbus) - Pulsadores Open/Close
    // Solo feeders tipo a (con pulsadores) se conectan; tipo b quedan FALSE
    DI_FEEDER_PB_OPEN : Array[1..19] of Bool;     // Pulsadores OPEN físicos feeders
    DI_FEEDER_PB_CLOSE : Array[1..19] of Bool;    // Pulsadores CLOSE físicos feeders
END_VAR

VAR_OUTPUT 
    // ========== SEÑALES LÓGICAS NORMALIZADAS ==========
    // Modo operativo
    MODE_AUTO : Bool;               // TRUE = Automático (SCMTA activo)
    MODE_MANUAL : Bool;             // TRUE = Manual (operador)
    
    // Permisos de control remoto por interruptor
    QT1_REMOTE_ALLOWED : Bool;      // TRUE = PLC puede comandar QT1
    QG1_REMOTE_ALLOWED : Bool;      // TRUE = PLC puede comandar QG1
    QG2_REMOTE_ALLOWED : Bool;      // TRUE = PLC puede comandar QG2
    
    // Requests manuales (pulsos de 1 scan generados por flanco)
    REQ_MAN_QT1_OPEN : Bool;        // Pulso: solicitud manual abrir QT1
    REQ_MAN_QT1_CLOSE : Bool;       // Pulso: solicitud manual cerrar QT1
    REQ_MAN_QG1_OPEN : Bool;
    REQ_MAN_QG1_CLOSE : Bool;
    REQ_MAN_QG2_OPEN : Bool;
    REQ_MAN_QG2_CLOSE : Bool;
    REQ_MAN_FEEDER_OPEN : Array[1..19] of Bool;   // Pulsos: solicitud manual abrir feeder[i]
    REQ_MAN_FEEDER_CLOSE : Array[1..19] of Bool;  // Pulsos: solicitud manual cerrar feeder[i]
    
    // Estados GD normalizados (passthrough)
    GD_READY : Bool;                // GD1 listo
    GD_RUNNING : Bool;              // GD1 en marcha
    GD_ALARM : Bool;                // GD1 alarma
    
    // Estados GD2 normalizados (passthrough)
    GD2_READY : Bool;               // GD2 listo
    GD2_RUNNING : Bool;             // GD2 en marcha
    GD2_ALARM : Bool;               // GD2 alarma
    
    // Diagnóstico
    DIAG_MODE_VALID : Bool;         // TRUE = modo válido detectado
END_VAR

VAR 
    // ========== MEMORIA INTERNA ==========
    // Memoria para detección de flanco (estado anterior)
    // Nota: debounce por hardware en módulos DI (filtro 6.4ms) - no se necesitan TON en SCL
    memQT1_PB_Open : Bool;
    memQT1_PB_Close : Bool;
    memQG1_PB_Open : Bool;
    memQG1_PB_Close : Bool;
    memQG2_PB_Open : Bool;
    memQG2_PB_Close : Bool;
    
    // Feeders (19) - Arrays para detección de flanco
    memFeeder_PB_Open : Array[1..19] of Bool;
    memFeeder_PB_Close : Array[1..19] of Bool;
END_VAR

VAR_TEMP
    i : Int;  // Loop counter para feeders
END_VAR

// Nota: filtro de entrada de hardware configurado en 6.4ms en TIA Portal (CPU onboard y SM 1223)
// No se requiere debounce adicional en SCL

BEGIN
    // ========================================================================
    // NETWORK 1: NORMALIZACIÓN MODO AUTO/MANUAL
    // ========================================================================
    // Lógica fail-safe: si señal indefinida, default a MANUAL
    MODE_AUTO := DI_SYS_AUTO;
    MODE_MANUAL := NOT DI_SYS_AUTO;
    DIAG_MODE_VALID := TRUE;  // TODO: agregar validación si hay señal redundante
    
    
    // ========================================================================
    // NETWORK 2: NORMALIZACIÓN LOCAL/REMOTO
    // ========================================================================
    // TRUE = Selector en posición REMOTO → PLC puede comandar
    // FALSE = Selector en posición LOCAL → PLC SOLO monitorea
    QT1_REMOTE_ALLOWED := DI_QT1_REMOTE_SEL;
    QG1_REMOTE_ALLOWED := DI_QG1_REMOTE_SEL;
    QG2_REMOTE_ALLOWED := DI_QG2_REMOTE_SEL;
    
    
    // ========================================================================
    // NETWORK 3: DETECCIÓN DE FLANCO POSITIVO (R_TRIG) → REQUESTS MANUALES
    // Filtro de rebotes: hardware (6.4ms en CPU onboard y SM 1223) - no se necesita TON en SCL
    // ========================================================================
    // Generamos PULSOS de 1 scan al detectar flanco ascendente 0→1
    
    // QT1 Open: flanco 0→1
    #REQ_MAN_QT1_OPEN  := #DI_QT1_PB_OPEN  AND NOT #memQT1_PB_Open;
    #memQT1_PB_Open    := #DI_QT1_PB_OPEN;
    
    // QT1 Close
    #REQ_MAN_QT1_CLOSE := #DI_QT1_PB_CLOSE AND NOT #memQT1_PB_Close;
    #memQT1_PB_Close   := #DI_QT1_PB_CLOSE;
    
    // QG1 Open
    #REQ_MAN_QG1_OPEN  := #DI_QG1_PB_Open  AND NOT #memQG1_PB_Open;
    #memQG1_PB_Open    := #DI_QG1_PB_Open;
    
    // QG1 Close
    #REQ_MAN_QG1_CLOSE := #DI_QG1_PB_CLOSE AND NOT #memQG1_PB_Close;
    #memQG1_PB_Close   := #DI_QG1_PB_CLOSE;
    
    // QG2 Open
    #REQ_MAN_QG2_OPEN  := #DI_QG2_PB_OPEN  AND NOT #memQG2_PB_Open;
    #memQG2_PB_Open    := #DI_QG2_PB_OPEN;
    
    // QG2 Close
    #REQ_MAN_QG2_CLOSE := #DI_QG2_PB_CLOSE AND NOT #memQG2_PB_Close;
    #memQG2_PB_Close   := #DI_QG2_PB_CLOSE;
    
    // FEEDERS (19) - Detección de flanco con FOR loop
    FOR #i := 1 TO 19 DO
        #REQ_MAN_FEEDER_OPEN[#i]  := #DI_FEEDER_PB_OPEN[#i]  AND NOT #memFeeder_PB_Open[#i];
        #memFeeder_PB_Open[#i]    := #DI_FEEDER_PB_OPEN[#i];
        #REQ_MAN_FEEDER_CLOSE[#i] := #DI_FEEDER_PB_CLOSE[#i] AND NOT #memFeeder_PB_Close[#i];
        #memFeeder_PB_Close[#i]   := #DI_FEEDER_PB_CLOSE[#i];
    END_FOR;
    
    
    // ========================================================================
    // NETWORK 5: NORMALIZACIÓN SEÑALES GD (PASSTHROUGH)
    // ========================================================================
    // GD1 (primario)
    #GD_READY := #DI_GD_READY;
    #GD_RUNNING := #DI_GD_RUNNING;
    #GD_ALARM := #DI_GD_ALARM;
    
    // GD2 (backup/redundante)
    #GD2_READY := #DI_GD2_READY;
    #GD2_RUNNING := #DI_GD2_RUNNING;
    #GD2_ALARM := #DI_GD2_ALARM;
    
END_FUNCTION_BLOCK
