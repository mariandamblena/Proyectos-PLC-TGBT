ORGANIZATION_BLOCK "Main"
TITLE = "Main Program Sweep (Cycle) — V4.0"
{ S7_Optimized_Access := 'TRUE' }
// ============================================================================
// OB1: Main  V4.0  — TGBT SCMTA
// ============================================================================
// CAMBIO ALCANCE V4:
//   - New DI mapping: QT1/QG1/QG2 REMOTE/CLOSE/FAULT/UV_OV + GD signals + Q22
//   - New DO mapping: pulse OPEN/CLOSE per breaker (%Q0.0-0.7) + GD RUN (%Q1.0-1.1)
//   - Eliminados: 07_FB_MTZ_DRIVER_DB_QT1/QG1/QG2
//   - Agregado: 06_FB_MODBUS_MANAGER (solo PM5350P, 7 dispositivos, solo lectura)
//   - Pulse expander: CMD_xx -> DO pulse mantenido T_CMD_PULSE (300ms)
//     IMPORTANTE: implementar con TON instances en un DB auxiliar
//   - Mantenido: 03_FB_SHED (ENABLE=FALSE en DB_PARAMS)
// ============================================================================
VERSION : 0.1
   VAR_TEMP
       rd_ret : Int;
       currentDTL : DTL;
       currentMonth : UInt;
       scmtaGd1RunReq : Bool;
       scmtaGd2RunReq : Bool;
       hmiGd1RunReq : Bool;
       hmiGd2RunReq : Bool;
   END_VAR

BEGIN

    // ========================================================================
    // NETWORK 1: NORMALIZACION ENTRADAS/SALIDAS  (01_FB_IO_NORMALIZE)
    // ========================================================================
    "01_FB_IO_NORMALIZE_DB"(
        // ---- Selector AUTO/MANUAL del sistema ----
        DI_SYS_AUTO       := "DATA_BUFF".MODE_AUTO,  // TODO: asignar DI fisica si existe

        // ---- QT1 (CPU %I0.0–%I0.3) ----
        DI_QT1_REMOTE     := %I0.0,
        DI_QT1_CLOSE      := %I0.1,
        DI_QT1_FAULT      := %I0.2,
        DI_QT1_UV_OV      := %I0.3,

        DI_BUSBAR_UV_OV   := %I0.4,

        // ---- QG1 (CPU %I0.5–%I1.0) ----
        DI_QG1_REMOTE     := %I0.5,
        DI_QG1_CLOSE      := %I0.6,
        DI_QG1_FAULT      := %I0.7,
        DI_QG1_UV_OV      := %I1.0,

        // ---- QG2 (CPU %I1.1–%I1.4) ----
        DI_QG2_REMOTE     := %I1.1,
        DI_QG2_CLOSE      := %I1.2,
        DI_QG2_FAULT      := %I1.3,
        DI_QG2_UV_OV      := %I1.4,

        // ---- Q22 (REMOTE en %I1.5) ----
        DI_Q22_REMOTE     := %I1.5,

        // ---- Outputs -> DATA_BUFF ----
        MODE_AUTO         => "DATA_BUFF".MODE_AUTO,
        MODE_MANUAL       => "DATA_BUFF".MODE_MANUAL,
        DIAG_MODE_VALID   => "DATA_BUFF".DIAG_MODE_VALID,

        QT1_CLOSED        => "DATA_BUFF".QT1_CLOSED,
        QT1_OPEN          => "DATA_BUFF".QT1_OPEN,
        QT1_FAULT         => "DATA_BUFF".QT1_FAULT,
        QT1_REMOTE        => "DATA_BUFF".QT1_REMOTE,
        QT1_UV_OV_DI      => "DATA_BUFF".QT1_UV_OV_DI,

        BUSBAR_UV_OV_DI   => "DATA_BUFF".BUSBAR_UV_OV_DI,

        QG1_CLOSED        => "DATA_BUFF".QG1_CLOSED,
        QG1_OPEN          => "DATA_BUFF".QG1_OPEN,
        QG1_FAULT         => "DATA_BUFF".QG1_FAULT,
        QG1_REMOTE        => "DATA_BUFF".QG1_REMOTE,
        QG1_UV_OV_DI      => "DATA_BUFF".QG1_UV_OV_DI,

        QG2_CLOSED        => "DATA_BUFF".QG2_CLOSED,
        QG2_OPEN          => "DATA_BUFF".QG2_OPEN,
        QG2_FAULT         => "DATA_BUFF".QG2_FAULT,
        QG2_REMOTE        => "DATA_BUFF".QG2_REMOTE,
        QG2_UV_OV_DI      => "DATA_BUFF".QG2_UV_OV_DI,

        Q22_REMOTE        => "DATA_BUFF".Q22_REMOTE
    );

    // Permisos remotos base (V4): permitidos cuando selector fisico esta en REMOTO
    "DATA_BUFF".QT1_REMOTE_ALLOWED := "DATA_BUFF".QT1_REMOTE;
    "DATA_BUFF".QG1_REMOTE_ALLOWED := "DATA_BUFF".QG1_REMOTE;
    "DATA_BUFF".QG2_REMOTE_ALLOWED := "DATA_BUFF".QG2_REMOTE;
    "DATA_BUFF".Q22_REMOTE_ALLOWED := "DATA_BUFF".Q22_REMOTE;
    "DATA_BUFF".Q22_CLOSED := %I8.0;
    "DATA_BUFF".Q22_FAULT  := %I8.1;


    // ========================================================================
    // NETWORK 2: MAQUINA DE ESTADOS SCMTA  (02_FB_SCMTA)
    // ========================================================================
    "02_FB_SCMTA_DB"(
        ENABLE               := "DB_PARAMS".ENABLE_SCMTA,
        MODE_AUTO            := "DATA_BUFF".MODE_AUTO,
        ENABLE_QG2           := "DB_PARAMS".ENABLE_QG2,
        ENABLE_AUTO_RETURN   := TRUE,
        RESET_FAULT          := "DATA_BUFF".RESET_FAULT,

        // Posicion/estado interruptores por DI
        QT1_CLOSED           := "DATA_BUFF".QT1_CLOSED,
        QT1_FAULT            := "DATA_BUFF".QT1_FAULT,
        QT1_REMOTE           := "DATA_BUFF".QT1_REMOTE,
        QT1_UV_OV_DI         := "DATA_BUFF".QT1_UV_OV_DI,

        QG1_CLOSED           := "DATA_BUFF".QG1_CLOSED,
        QG1_FAULT            := "DATA_BUFF".QG1_FAULT,
        QG1_REMOTE           := "DATA_BUFF".QG1_REMOTE,

        QG2_CLOSED           := "DATA_BUFF".QG2_CLOSED,
        QG2_FAULT            := "DATA_BUFF".QG2_FAULT,
        QG2_REMOTE           := "DATA_BUFF".QG2_REMOTE,
        Q22_CLOSED           := "DATA_BUFF".Q22_CLOSED,

        // Mediciones RED (PM5350P C02, indice 1)
        GRID_V_L1L2          := "DATA_BUFF".GRID_V_L1L2,
        GRID_V_L2L3          := "DATA_BUFF".GRID_V_L2L3,
        GRID_V_L3L1          := "DATA_BUFF".GRID_V_L3L1,
        GRID_FREQ            := "DATA_BUFF".GRID_FREQ,
        GRID_MEASUREMENT_OK  := "DATA_BUFF".GRID_MEASUREMENT_OK,
        GRID_PHASE_LOSS      := "DATA_BUFF".GRID_PHASE_LOSS,
        GRID_ALM_UV          := "DATA_BUFF".GRID_ALM_UV,
        GRID_ALM_OV          := "DATA_BUFF".GRID_ALM_OV,

        // GD criteria por medicion electrica + Modbus OK
        GD1_V_L1L2           := "DATA_BUFF".GD1_V_L1L2,
        GD1_V_L2L3           := "DATA_BUFF".GD1_V_L2L3,
        GD1_V_L3L1           := "DATA_BUFF".GD1_V_L3L1,
        GD1_FREQ             := "DATA_BUFF".GD1_FREQ,
        GD1_MEASUREMENT_OK   := "DATA_BUFF".GD1_MEASUREMENT_OK,
        GD2_V_L1L2           := "DATA_BUFF".GD2_V_L1L2,
        GD2_V_L2L3           := "DATA_BUFF".GD2_V_L2L3,
        GD2_V_L3L1           := "DATA_BUFF".GD2_V_L3L1,
        GD2_FREQ             := "DATA_BUFF".GD2_FREQ,
        GD2_MEASUREMENT_OK   := "DATA_BUFF".GD2_MEASUREMENT_OK,

        // Parametros (de DB_PARAMS)
        V_NOM                := "DB_PARAMS".V_NOM,
        V_MIN_PCT            := "DB_PARAMS".V_MIN_PCT,
        V_MAX_PCT            := "DB_PARAMS".V_MAX_PCT,
        FREQ_NOM             := "DB_PARAMS".FREQ_NOM,
        FREQ_MIN             := "DB_PARAMS".FREQ_MIN,
        FREQ_MAX             := "DB_PARAMS".FREQ_MAX,
        T_OPEN_QT1           := "DB_PARAMS".T_OPEN_QT1,
        T_OPEN_Q22           := "DB_PARAMS".T_OPEN_Q22,
        T_START_GD_DELAY     := "DB_PARAMS".T_START_GD_DELAY,
        T_GD_READY_TIMEOUT   := "DB_PARAMS".T_GD_READY_TIMEOUT,
        MAX_GD_START_RETRIES := "DB_PARAMS".MAX_GD_START_RETRIES,
        T_GD_STABILIZATION   := "DB_PARAMS".T_GD_STABILIZATION,
        T_CLOSE_QG1          := "DB_PARAMS".T_CLOSE_QG1,
        T_CLOSE_QG2          := "DB_PARAMS".T_CLOSE_QG2,
        T_GRID_STABLE        := "DB_PARAMS".T_GRID_STABLE,
        T_OPEN_QG1           := "DB_PARAMS".T_OPEN_QG1,
        T_OPEN_QG2           := "DB_PARAMS".T_OPEN_QG2,
        T_CLOSE_QT1          := "DB_PARAMS".T_CLOSE_QT1,
        T_DELAY_CLOSE_Q22    := "DB_PARAMS".T_DELAY_CLOSE_Q22,
        T_CLOSE_Q22          := "DB_PARAMS".T_CLOSE_Q22,
        T_GD_COOLDOWN        := "DB_PARAMS".T_GD_COOLDOWN,
        T_GRID_FAIL_FILTER   := "DB_PARAMS".T_GRID_FAIL_FILTER,
        T_MIN_GD_STAY        := "DB_PARAMS".T_MIN_GD_STAY,

        // Outputs -> DATA_BUFF
        STATE                => "DATA_BUFF".SCMTA_STATE,
        STATE_NAME           => "DATA_BUFF".SCMTA_STATE_NAME,
        REQ_SCMTA_OPEN_QT1   => "02_FB_SCMTA_DB".REQ_SCMTA_OPEN_QT1,
        REQ_SCMTA_CLOSE_QT1  => "02_FB_SCMTA_DB".REQ_SCMTA_CLOSE_QT1,
        REQ_SCMTA_OPEN_QG1   => "02_FB_SCMTA_DB".REQ_SCMTA_OPEN_QG1,
        REQ_SCMTA_CLOSE_QG1  => "02_FB_SCMTA_DB".REQ_SCMTA_CLOSE_QG1,
        REQ_SCMTA_OPEN_QG2   => "02_FB_SCMTA_DB".REQ_SCMTA_OPEN_QG2,
        REQ_SCMTA_CLOSE_QG2  => "02_FB_SCMTA_DB".REQ_SCMTA_CLOSE_QG2,
        REQ_SCMTA_OPEN_Q22   => "02_FB_SCMTA_DB".REQ_SCMTA_OPEN_Q22,
        REQ_SCMTA_CLOSE_Q22  => "02_FB_SCMTA_DB".REQ_SCMTA_CLOSE_Q22,
        DO_GD_START          => #scmtaGd1RunReq,
        DO_GD_STOP           => "DATA_BUFF".GD_STOP_REQ,
        DO_GD2_START         => #scmtaGd2RunReq,
        DO_GD2_STOP          => "DATA_BUFF".GD2_STOP_REQ,
        IS_ON_GRID           => "DATA_BUFF".IS_ON_GRID,
        IS_ON_GD             => "DATA_BUFF".IS_ON_GD,
        IS_ON_GD1            => "DATA_BUFF".IS_ON_GD1,
        IS_ON_GD2            => "DATA_BUFF".IS_ON_GD2,
        ACTIVE_GD            => "DATA_BUFF".ACTIVE_GD,
        IS_IN_TRANSFER       => "DATA_BUFF".IS_IN_TRANSFER,
        IS_FAULT             => "DATA_BUFF".IS_FAULT,
        TRANSFER_TO_GD       => "DATA_BUFF".TRANSFER_TO_GD,
        GRID_OK              => "DATA_BUFF".GRID_OK,
        GRID_FAIL            => "DATA_BUFF".GRID_FAIL,
        FAULT_CODE           => "DATA_BUFF".FAULT_CODE,
        ELAPSED_TIME         => "DATA_BUFF".ELAPSED_TIME,
        DIAG_LAST_TRANSFER_TIME => "DATA_BUFF".DIAG_LAST_TRANSFER_TIME,
        GD1_AVAILABLE        => "DATA_BUFF".GD1_AVAILABLE,
        GD2_AVAILABLE        => "DATA_BUFF".GD2_AVAILABLE
    );

    // Habilitacion HMI para prueba de marcha GD, sin transferencia.
    "DATA_BUFF".HMI_GD1_RUN_ENABLE :=
        "DATA_BUFF".MODE_MANUAL
        AND NOT "DATA_BUFF".IS_IN_TRANSFER
        AND NOT "DATA_BUFF".QG1_CLOSED;
    "DATA_BUFF".HMI_GD2_RUN_ENABLE :=
        "DATA_BUFF".MODE_MANUAL
        AND NOT "DATA_BUFF".IS_IN_TRANSFER
        AND NOT "DATA_BUFF".QG2_CLOSED;

    #hmiGd1RunReq := "DATA_BUFF".REQ_MAN_GD1_RUN
                     AND "DATA_BUFF".HMI_GD1_RUN_ENABLE;
    #hmiGd2RunReq := "DATA_BUFF".REQ_MAN_GD2_RUN
                     AND "DATA_BUFF".HMI_GD2_RUN_ENABLE;

    // Salidas RUN GD: SCMTA automatico OR prueba manual desde HMI.
    %Q1.0 := #scmtaGd1RunReq OR #hmiGd1RunReq;
    %Q1.1 := #scmtaGd2RunReq OR #hmiGd2RunReq;

    // GD STOP: reset Q1.0/Q1.1 cuando SCMTA pide parar
    IF "DATA_BUFF".GD_STOP_REQ  THEN %Q1.0 := FALSE; END_IF;
    IF "DATA_BUFF".GD2_STOP_REQ THEN %Q1.1 := FALSE; END_IF;


    // ========================================================================
    // NETWORK 3: DESLASTRE (03_FB_SHED) —  ENABLE_SHED=FALSE en V4
    // ========================================================================
    "03_FB_SHED_DB"(
        ENABLE              := "DB_PARAMS".ENABLE_SHED,  // FALSE en V4
        MODE_AUTO           := "DATA_BUFF".MODE_AUTO,
        IS_ON_GD            := "DATA_BUFF".IS_ON_GD,
        IS_ON_GRID          := "DATA_BUFF".IS_ON_GRID,
        IS_IN_TRANSFER      := "DATA_BUFF".IS_IN_TRANSFER,
        TRANSFER_TO_GD      := "DATA_BUFF".TRANSFER_TO_GD,
        GD_LoadPct          := 0.0,
        TR_LoadPct          := 0.0,
        GD_SHED_ON          := "DB_PARAMS".GD_SHED_ON,
        GD_SHED_OFF         := "DB_PARAMS".GD_SHED_OFF,
        GRID_SHED_ON        := "DB_PARAMS".GRID_SHED_ON,
        GRID_SHED_OFF       := "DB_PARAMS".GRID_SHED_OFF,
        T_SHED_STEP         := "DB_PARAMS".T_SHED_STEP,
        T_RECONNECT_STEP    := "DB_PARAMS".T_RECONNECT_STEP,
        T_LOAD_FILTER       := "DB_PARAMS".T_LOAD_FILTER,
        T_LOAD_CHECK_DELAY  := "DB_PARAMS".T_LOAD_CHECK_DELAY,
        SHED_ORDER          := "DB_PARAMS".SHED_ORDER,
        RECONNECT_ORDER     := "DB_PARAMS".RECONNECT_ORDER,
        FEEDER_ESSENTIAL    := "DB_PARAMS".FEEDER_ESSENTIAL,
        SHED_ENABLE         := "DB_PARAMS".SHED_ENABLE,
        FEEDER_STATE        := "DB_PARAMS".SHED_ORDER,  // placeholder: sin feeders en V4
        SHED_ACTIVE         => "DATA_BUFF".SHED_ACTIVE
    );


    // ========================================================================
    // NETWORK 4: ARBITRO DE COMANDOS  (04_FB_CMD_ARBITER)
    // ========================================================================
    "04_FB_CMD_ARBITER_DB"(
        REQ_SCMTA_OPEN_QT1  := "02_FB_SCMTA_DB".REQ_SCMTA_OPEN_QT1,
        REQ_SCMTA_CLOSE_QT1 := "02_FB_SCMTA_DB".REQ_SCMTA_CLOSE_QT1,
        REQ_SCMTA_OPEN_QG1  := "02_FB_SCMTA_DB".REQ_SCMTA_OPEN_QG1,
        REQ_SCMTA_CLOSE_QG1 := "02_FB_SCMTA_DB".REQ_SCMTA_CLOSE_QG1,
        REQ_SCMTA_OPEN_QG2  := "02_FB_SCMTA_DB".REQ_SCMTA_OPEN_QG2,
        REQ_SCMTA_CLOSE_QG2 := "02_FB_SCMTA_DB".REQ_SCMTA_CLOSE_QG2,
        REQ_SCMTA_OPEN_Q22  := "02_FB_SCMTA_DB".REQ_SCMTA_OPEN_Q22,
        REQ_SCMTA_CLOSE_Q22 := "02_FB_SCMTA_DB".REQ_SCMTA_CLOSE_Q22,
        REQ_MAN_QT1_OPEN    := "DATA_BUFF".REQ_MAN_QT1_OPEN,
        REQ_MAN_QT1_CLOSE   := "DATA_BUFF".REQ_MAN_QT1_CLOSE,
        REQ_MAN_QG1_OPEN    := "DATA_BUFF".REQ_MAN_QG1_OPEN,
        REQ_MAN_QG1_CLOSE   := "DATA_BUFF".REQ_MAN_QG1_CLOSE,
        REQ_MAN_QG2_OPEN    := "DATA_BUFF".REQ_MAN_QG2_OPEN,
        REQ_MAN_QG2_CLOSE   := "DATA_BUFF".REQ_MAN_QG2_CLOSE,
        REQ_MAN_Q22_OPEN    := "DATA_BUFF".REQ_MAN_Q22_OPEN,
        REQ_MAN_Q22_CLOSE   := "DATA_BUFF".REQ_MAN_Q22_CLOSE,
        MODE_AUTO           := "DATA_BUFF".MODE_AUTO,
        MODE_MANUAL         := "DATA_BUFF".MODE_MANUAL,
        QT1_CLOSED          := "DATA_BUFF".QT1_CLOSED,
        QG1_CLOSED          := "DATA_BUFF".QG1_CLOSED,
        QG2_CLOSED          := "DATA_BUFF".QG2_CLOSED,
        QT1_REMOTE          := "DATA_BUFF".QT1_REMOTE_ALLOWED,
        QG1_REMOTE          := "DATA_BUFF".QG1_REMOTE_ALLOWED,
        QG2_REMOTE          := "DATA_BUFF".QG2_REMOTE_ALLOWED,
        Q22_REMOTE          := "DATA_BUFF".Q22_REMOTE_ALLOWED,
        BLOCK_LOCAL         => "DATA_BUFF".BLOCK_LOCAL,
        BLOCK_INTERLOCK     => "DATA_BUFF".BLOCK_INTERLOCK,
        BLOCK_CONFLICT      => "DATA_BUFF".BLOCK_CONFLICT,
        ALM_INTERLOCK_VIOLATION => "DATA_BUFF".ALM_INTERLOCK_VIOLATION
    );


    // ========================================================================
    // NETWORK 5: PULSE EXPANDER — CMD -> DO pulso T_CMD_PULSE (300 ms)
    // ========================================================================
    // 12_FB_PULSE_EXPANDER convierte cada CMD (1 scan) en un pulso sostenido
    // de T_CMD_PULSE (300 ms) sobre las salidas fisicas %Q0.0..%Q0.7.
    // Internamente usa 8 pares R_TRIG + TON con latch.
    // Los DO se activan via OUT_x => %Q0.x en la llamada de abajo.
    //
    // %Q0.0 = DO_QT1_CLOSE_CMD   (pulse CERRAR QT1)
    // %Q0.1 = DO_QT1_OPEN_CMD    (pulse ABRIR QT1)
    // %Q0.2 = DO_QG1_CLOSE_CMD   (pulse CERRAR QG1)
    // %Q0.3 = DO_QG1_OPEN_CMD    (pulse ABRIR QG1)
    // %Q0.4 = DO_QG2_CLOSE_CMD   (pulse CERRAR QG2)
    // %Q0.5 = DO_QG2_OPEN_CMD    (pulse ABRIR QG2)
    // %Q0.6 = DO_Q22_CLOSE_CMD   (pulse CERRAR Q22)
    // %Q0.7 = DO_Q22_OPEN_CMD    (pulse ABRIR Q22)

    "12_PULSE_EXPANDER_DB"(
        T_PULSE  := "DB_PARAMS".T_CMD_PULSE,
        TRIG_1   := "04_FB_CMD_ARBITER_DB".CMD_CLOSE_QT1,
        TRIG_2   := "04_FB_CMD_ARBITER_DB".CMD_OPEN_QT1,
        TRIG_3   := "04_FB_CMD_ARBITER_DB".CMD_CLOSE_QG1,
        TRIG_4   := "04_FB_CMD_ARBITER_DB".CMD_OPEN_QG1,
        TRIG_5   := "04_FB_CMD_ARBITER_DB".CMD_CLOSE_QG2,
        TRIG_6   := "04_FB_CMD_ARBITER_DB".CMD_OPEN_QG2,
        TRIG_7   := "04_FB_CMD_ARBITER_DB".CMD_CLOSE_Q22,
        TRIG_8   := "04_FB_CMD_ARBITER_DB".CMD_OPEN_Q22,
        OUT_1    => %Q0.0,
        OUT_2    => %Q0.1,
        OUT_3    => %Q0.2,
        OUT_4    => %Q0.3,
        OUT_5    => %Q0.4,
        OUT_6    => %Q0.5,
        OUT_7    => %Q0.6,
        OUT_8    => %Q0.7
    );


    // ========================================================================
    // NETWORK 6: GESTOR MODBUS PM5350P  (06_FB_MODBUS_MANAGER)
    // ========================================================================
    "06_FB_MODBUS_MANAGER_DB"(
        ENABLE         := "DB_PARAMS".ENABLE_SCMTA,
        FIRST_SCAN     := %M800.0,     // FirstScan: TRUE solo en el primer ciclo
        SLAVE_C02      := "DB_PARAMS".SLAVE_ID_PM5350_C02,
        SLAVE_C01_GD1  := "DB_PARAMS".SLAVE_ID_PM5350_C01_GD1,
        SLAVE_C01_GD2  := "DB_PARAMS".SLAVE_ID_PM5350_C01_GD2,
        SLAVE_C03      := "DB_PARAMS".SLAVE_ID_PM5350_C03,
        SLAVE_C04      := "DB_PARAMS".SLAVE_ID_PM5350_C04,
        SLAVE_C05      := "DB_PARAMS".SLAVE_ID_PM5350_C05,
        SLAVE_C06      := "DB_PARAMS".SLAVE_ID_PM5350_C06,
        PORT_ID        := "DB_PARAMS".MB_PORT_ID,
        BAUD_RATE      := "DB_PARAMS".MB_BAUD_RATE,
        PARITY         := "DB_PARAMS".MB_PARITY,
        RESP_TIMEOUT   := "DB_PARAMS".MB_RESP_TIMEOUT,
        // V5.1: sin T_POLL_CYCLE ni T_PAUSE_BETWEEN — REQ siempre activo,
        //        MB_MASTER gestiona BLOCKED_PROC_TIMEOUT internamente
        // Outputs: mediciones PM5350P -> DATA_BUFF
        // Indice 1 = C02/RED, 2 = C01-GD1, 3 = C01-GD2, 4..7 = C03-C06
        COMM_OK        => "DATA_BUFF".MODBUS_COMM_OK,
        GRID_MEAS_OK   => "DATA_BUFF".GRID_MEASUREMENT_OK,
        ACTIVE_DEVICE  => "DATA_BUFF".MODBUS_ACTIVE_DEVICE,
        PORT_CFG_DONE  => "DATA_BUFF".MB_PORT_CFG_DONE,
        PORT_CFG_ERROR => "DATA_BUFF".MB_PORT_CFG_ERROR,
        PORT_CFG_STATUS => "DATA_BUFF".MB_PORT_CFG_STATUS
    );
    // PM_COMM_OK[1] = medidor C02/RED; TRUE si tiene lectura valida reciente
    "DATA_BUFF".PM_COMM_OK := "06_FB_MODBUS_MANAGER_DB".PM_COMM_OK[1];

    // Copiar mediciones red (C02 = indice 1) a variables de nombres en DATA_BUFF
    "DATA_BUFF".GRID_I_L1   := "06_FB_MODBUS_MANAGER_DB".PM_I_L1[1];
    "DATA_BUFF".GRID_I_L2   := "06_FB_MODBUS_MANAGER_DB".PM_I_L2[1];
    "DATA_BUFF".GRID_I_L3   := "06_FB_MODBUS_MANAGER_DB".PM_I_L3[1];
    "DATA_BUFF".GRID_V_L1L2 := "06_FB_MODBUS_MANAGER_DB".PM_V_L1L2[1];
    "DATA_BUFF".GRID_V_L2L3 := "06_FB_MODBUS_MANAGER_DB".PM_V_L2L3[1];
    "DATA_BUFF".GRID_V_L3L1 := "06_FB_MODBUS_MANAGER_DB".PM_V_L3L1[1];
    "DATA_BUFF".GRID_FREQ    := "06_FB_MODBUS_MANAGER_DB".PM_FREQ[1];
    "DATA_BUFF".GRID_ALM_UV  := "06_FB_MODBUS_MANAGER_DB".PM_ALARM[1];
    "DATA_BUFF".GRID_ALM_OV  := "06_FB_MODBUS_MANAGER_DB".PM_ALARM[1];
    "DATA_BUFF".GRID_MEASUREMENT_OK := "06_FB_MODBUS_MANAGER_DB".PM_COMM_OK[1];
    // Copiar potencia total de la red (PM_P_TOTAL indice 1)
    "DATA_BUFF".GRID_P_TOTAL := "06_FB_MODBUS_MANAGER_DB".PM_P_TOTAL[1];

    // Copiar mediciones GD1 (C01-GD1 = indice 2)
    "DATA_BUFF".GD1_I_L1    := "06_FB_MODBUS_MANAGER_DB".PM_I_L1[2];
    "DATA_BUFF".GD1_I_L2    := "06_FB_MODBUS_MANAGER_DB".PM_I_L2[2];
    "DATA_BUFF".GD1_I_L3    := "06_FB_MODBUS_MANAGER_DB".PM_I_L3[2];
    "DATA_BUFF".GD1_V_L1L2  := "06_FB_MODBUS_MANAGER_DB".PM_V_L1L2[2];
    "DATA_BUFF".GD1_V_L2L3  := "06_FB_MODBUS_MANAGER_DB".PM_V_L2L3[2];
    "DATA_BUFF".GD1_V_L3L1  := "06_FB_MODBUS_MANAGER_DB".PM_V_L3L1[2];
    "DATA_BUFF".GD1_FREQ    := "06_FB_MODBUS_MANAGER_DB".PM_FREQ[2];
    "DATA_BUFF".GD1_P_TOTAL := "06_FB_MODBUS_MANAGER_DB".PM_P_TOTAL[2];
    "DATA_BUFF".GD1_MEASUREMENT_OK := "06_FB_MODBUS_MANAGER_DB".PM_COMM_OK[2];

    // Copiar mediciones GD2 (C01-GD2 = indice 3)
    "DATA_BUFF".GD2_I_L1    := "06_FB_MODBUS_MANAGER_DB".PM_I_L1[3];
    "DATA_BUFF".GD2_I_L2    := "06_FB_MODBUS_MANAGER_DB".PM_I_L2[3];
    "DATA_BUFF".GD2_I_L3    := "06_FB_MODBUS_MANAGER_DB".PM_I_L3[3];
    "DATA_BUFF".GD2_V_L1L2  := "06_FB_MODBUS_MANAGER_DB".PM_V_L1L2[3];
    "DATA_BUFF".GD2_V_L2L3  := "06_FB_MODBUS_MANAGER_DB".PM_V_L2L3[3];
    "DATA_BUFF".GD2_V_L3L1  := "06_FB_MODBUS_MANAGER_DB".PM_V_L3L1[3];
    "DATA_BUFF".GD2_FREQ    := "06_FB_MODBUS_MANAGER_DB".PM_FREQ[3];
    "DATA_BUFF".GD2_P_TOTAL := "06_FB_MODBUS_MANAGER_DB".PM_P_TOTAL[3];
    "DATA_BUFF".GD2_MEASUREMENT_OK := "06_FB_MODBUS_MANAGER_DB".PM_COMM_OK[3];

    // Copiar mediciones C03..C06 (indices 4..7)
    "DATA_BUFF".C03_V_L1L2  := "06_FB_MODBUS_MANAGER_DB".PM_V_L1L2[4];
    "DATA_BUFF".C03_P_TOTAL := "06_FB_MODBUS_MANAGER_DB".PM_P_TOTAL[4];
    "DATA_BUFF".C03_MEASUREMENT_OK := "06_FB_MODBUS_MANAGER_DB".PM_COMM_OK[4];

    "DATA_BUFF".C04_V_L1L2  := "06_FB_MODBUS_MANAGER_DB".PM_V_L1L2[5];
    "DATA_BUFF".C04_P_TOTAL := "06_FB_MODBUS_MANAGER_DB".PM_P_TOTAL[5];
    "DATA_BUFF".C04_MEASUREMENT_OK := "06_FB_MODBUS_MANAGER_DB".PM_COMM_OK[5];

    "DATA_BUFF".C05_V_L1L2  := "06_FB_MODBUS_MANAGER_DB".PM_V_L1L2[6];
    "DATA_BUFF".C05_P_TOTAL := "06_FB_MODBUS_MANAGER_DB".PM_P_TOTAL[6];
    "DATA_BUFF".C05_MEASUREMENT_OK := "06_FB_MODBUS_MANAGER_DB".PM_COMM_OK[6];

    "DATA_BUFF".C06_V_L1L2  := "06_FB_MODBUS_MANAGER_DB".PM_V_L1L2[7];
    "DATA_BUFF".C06_P_TOTAL := "06_FB_MODBUS_MANAGER_DB".PM_P_TOTAL[7];
    "DATA_BUFF".C06_MEASUREMENT_OK := "06_FB_MODBUS_MANAGER_DB".PM_COMM_OK[7];

    // ====================================================================
    // Registrar máximo mensual de consumo de la red (GRID)
    // - Reset manual: poner DB_MONTH_MAX_GRID.MONTH_MAX_GRID_RESET = TRUE desde HMI
    // - Auto-reset al cambiar de mes usando RD_SYS_T
    // ====================================================================
    // Leer hora del sistema
    // Instrucción sistema: leer fecha/hora del CPU (module time)
    rd_ret := RD_SYS_T(currentDTL);

    // Usar la fecha solo si la lectura fue correcta (rd_ret = 0)
    IF rd_ret = 0 THEN

        // Extraer mes (asumo campo .Month disponible en tipo DTL)
        currentMonth := currentDTL.Month;

        // Inicializar month si 0
        IF "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_MONTH = 0 THEN
            "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_MONTH := currentMonth;
        END_IF;

        // Reset automático al cambiar de mes
        IF currentMonth <> "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_MONTH THEN
            "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_P := 0.0;
            "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_TS := currentDTL;
            "DB_MONTH_MAX_GRID".MONTH_MIN_GRID_P := 0.0;
            "DB_MONTH_MAX_GRID".MONTH_MIN_GRID_TS := currentDTL;
            "DB_MONTH_MAX_GRID".MONTH_MIN_GRID_SCAN := 0;
            "DB_MONTH_MAX_GRID".MONTH_MIN_GRID_VALID := FALSE;
            "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_MONTH := currentMonth;
            "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_SCAN := 0;
        END_IF;

        // Reset manual
        IF "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_RESET THEN
            "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_P := 0.0;
            "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_TS := currentDTL;
            "DB_MONTH_MAX_GRID".MONTH_MIN_GRID_P := 0.0;
            "DB_MONTH_MAX_GRID".MONTH_MIN_GRID_TS := currentDTL;
            "DB_MONTH_MAX_GRID".MONTH_MIN_GRID_SCAN := 0;
            "DB_MONTH_MAX_GRID".MONTH_MIN_GRID_VALID := FALSE;
            "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_MONTH := currentMonth;
            "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_SCAN := 0;
            "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_RESET := FALSE;
        END_IF;

        // Actualizar máximo y timestamp cuando corresponde
        IF "DATA_BUFF".GRID_MEASUREMENT_OK THEN
            IF "DATA_BUFF".GRID_P_TOTAL > "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_P THEN
                "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_P := "DATA_BUFF".GRID_P_TOTAL;
                "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_TS := currentDTL;
                IF "DATA_BUFF".SYSTEM_UPTIME >= T#0ms THEN
                    "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_SCAN := DINT_TO_UDINT(TIME_TO_DINT("DATA_BUFF".SYSTEM_UPTIME));
                ELSE
                    "DB_MONTH_MAX_GRID".MONTH_MAX_GRID_SCAN := 0;
                END_IF;
            END_IF;

            IF (NOT "DB_MONTH_MAX_GRID".MONTH_MIN_GRID_VALID) OR
               ("DATA_BUFF".GRID_P_TOTAL < "DB_MONTH_MAX_GRID".MONTH_MIN_GRID_P) THEN
                "DB_MONTH_MAX_GRID".MONTH_MIN_GRID_P := "DATA_BUFF".GRID_P_TOTAL;
                "DB_MONTH_MAX_GRID".MONTH_MIN_GRID_TS := currentDTL;
                "DB_MONTH_MAX_GRID".MONTH_MIN_GRID_VALID := TRUE;
                IF "DATA_BUFF".SYSTEM_UPTIME >= T#0ms THEN
                    "DB_MONTH_MAX_GRID".MONTH_MIN_GRID_SCAN := DINT_TO_UDINT(TIME_TO_DINT("DATA_BUFF".SYSTEM_UPTIME));
                ELSE
                    "DB_MONTH_MAX_GRID".MONTH_MIN_GRID_SCAN := 0;
                END_IF;
            END_IF;
        END_IF;

    END_IF;


    // ========================================================================
    // NETWORK 7: GESTION DE SALIDAS PILOTOS Y HMI  (05_FB_OUTPUTS)
    // ========================================================================
    "05_FB_OUTPUTS_DB"(
        IS_ON_GRID     := "DATA_BUFF".IS_ON_GRID,
        IS_ON_GD       := "DATA_BUFF".IS_ON_GD,
        IS_IN_TRANSFER := "DATA_BUFF".IS_IN_TRANSFER,
        IS_FAULT       := "DATA_BUFF".IS_FAULT,
        STATE          := "DATA_BUFF".SCMTA_STATE,
        STATE_NAME     := "DATA_BUFF".SCMTA_STATE_NAME,
        FAULT_CODE     := "DATA_BUFF".FAULT_CODE,
        QT1_CLOSED     := "DATA_BUFF".QT1_CLOSED,
        QT1_FAULT      := "DATA_BUFF".QT1_FAULT,
        QG1_CLOSED     := "DATA_BUFF".QG1_CLOSED,
        QG1_FAULT      := "DATA_BUFF".QG1_FAULT,
        QG2_CLOSED     := "DATA_BUFF".QG2_CLOSED,
        QG2_FAULT      := "DATA_BUFF".QG2_FAULT,
        Q22_CLOSED     := "DATA_BUFF".Q22_CLOSED,
        Q22_FAULT      := "DATA_BUFF".Q22_FAULT,
        ALM_INTERLOCK_VIOLATION := "DATA_BUFF".ALM_INTERLOCK_VIOLATION,
        BLOCK_INTERLOCK := "DATA_BUFF".BLOCK_INTERLOCK,
        GRID_FAIL      := "DATA_BUFF".GRID_FAIL,
        ACK_ALARM      := "DATA_BUFF".ACK_ALARM,
        // Outputs piloto sistema
        DO_PILOT_ON_GRID   => "DATA_BUFF".PILOT_ON_GRID,
        DO_PILOT_ON_GD     => "DATA_BUFF".PILOT_ON_GD,
        DO_PILOT_FAULT     => "DATA_BUFF".PILOT_FAULT,
        // Pilotos interruptores (mapear a expansion DO spare o alarmas)
        DO_PILOT_QT1_OPEN   => "DATA_BUFF".PILOT_QT1_OPEN,
        DO_PILOT_QT1_CLOSED => "DATA_BUFF".PILOT_QT1_CLOSED,
        DO_PILOT_QT1_FAULT  => "DATA_BUFF".PILOT_QT1_FAULT,
        DO_PILOT_QG1_OPEN   => "DATA_BUFF".PILOT_QG1_OPEN,
        DO_PILOT_QG1_CLOSED => "DATA_BUFF".PILOT_QG1_CLOSED,
        DO_PILOT_QG1_FAULT  => "DATA_BUFF".PILOT_QG1_FAULT,
        DO_PILOT_QG2_OPEN   => "DATA_BUFF".PILOT_QG2_OPEN,
        DO_PILOT_QG2_CLOSED => "DATA_BUFF".PILOT_QG2_CLOSED,
        DO_PILOT_QG2_FAULT  => "DATA_BUFF".PILOT_QG2_FAULT,
        DO_PILOT_Q22_OPEN   => "DATA_BUFF".PILOT_Q22_OPEN,
        DO_PILOT_Q22_CLOSED => "DATA_BUFF".PILOT_Q22_CLOSED,
        DO_PILOT_Q22_FAULT  => "DATA_BUFF".PILOT_Q22_FAULT,
        DO_ALARM_BEACON    => %Q1.2,  // Sirena fisica (salida siguiente a GD2 RUN)
        HMI_STATUS_TEXT    => "DATA_BUFF".SCMTA_STATE_NAME,
        HMI_ALARM_ACTIVE   => "DATA_BUFF".HMI_ALARM_ACTIVE,
        HMI_ALARM_TEXT     => "DATA_BUFF".HMI_ALARM_TEXT
    );


    // ========================================================================
    // NETWORK 8: CALCULOS AUXILIARES DE CARGA
    // ========================================================================
    // NOTA UNIDADES: PM5350P registro 3060 (Active Power Total) entrega FLOAT32
    //   directamente en kW (fuente: PM51xx_PM53xx_PMC Register List).
    //   GD1_POWER_NOMINAL tambien esta en kW → division directa, SIN /1000.

    // Carga GD1 en porcentaje
    IF "DB_PARAMS".GD1_POWER_NOMINAL > 0.0 THEN
        "DATA_BUFF".GD_LoadPct :=
            ("DATA_BUFF".GD1_P_TOTAL / "DB_PARAMS".GD1_POWER_NOMINAL) * 100.0;
    ELSE
        "DATA_BUFF".GD_LoadPct := 0.0;
    END_IF;

    // Carga GD2 en porcentaje
    IF "DB_PARAMS".GD2_POWER_NOMINAL > 0.0 THEN
        "DATA_BUFF".TR_LoadPct :=
            ("DATA_BUFF".GD2_P_TOTAL / "DB_PARAMS".GD2_POWER_NOMINAL) * 100.0;
    ELSE
        "DATA_BUFF".TR_LoadPct := 0.0;
    END_IF;

END_ORGANIZATION_BLOCK
