FUNCTION_BLOCK "02_FB_SCMTA"
// ============================================================
// Versión: 4.0  Fecha: 2026-03-03
// CAMBIOS V4:
//  - Estado interruptores por DI físicas (QT1_CLOSED, QT1_FAULT, etc.)
//  - Sin FB_MTZ_DRIVER: confirmación apertura/cierre por DI
//  - Calidad de red desde PM5350P Modbus + backup DI_QT1_UV_OV
//  - ENABLE_QG2: deshabilita todo el camino GD2
//  - FAULT_LOCKOUT: auto-recovery con prioridad RED, timer estabilización
// ============================================================
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      ENABLE : Bool;
      MODE_AUTO : Bool;
      RESET_FAULT : Bool;
      ENABLE_QG2 : Bool;               // FALSE = QG2 no instalado
      ENABLE_AUTO_RETURN : Bool := TRUE;
      // ---- ESTADO INTERRUPTORES (DI físicas V4) ----
      QT1_CLOSED : Bool;               // DI %I0.1
      QT1_FAULT : Bool;                // DI %I0.2
      QT1_REMOTE : Bool;               // DI %I0.0
      QG1_CLOSED : Bool;               // DI %I0.6
      QG1_FAULT : Bool;                // DI %I0.7
      QG1_REMOTE : Bool;               // DI %I0.5
      QG2_CLOSED : Bool;               // DI %I1.2
      QG2_FAULT : Bool;                // DI %I1.3
      QG2_REMOTE : Bool;               // DI %I1.1
      Q22_CLOSED : Bool;               // DI posicion Q22 (cablear si disponible; FALSE = sin feedback)
      T_OPEN_Q22 : Time := T#3s;       // Tiempo max confirmacion apertura Q22
    T_DELAY_CLOSE_Q22 : Time := T#0s;// Espera en estado CLOSE_Q22 antes de mandar cierre
      T_CLOSE_Q22 : Time := T#3s;      // Tiempo max confirmacion cierre Q22
      QT1_UV_OV_DI : Bool;             // DI %I0.3 (señal backup DO PM5350P C02)
      // ---- MEDICIONES RED desde PM5350P C02 (fuente principal) ----
      GRID_V_L1L2 : Real;
      GRID_V_L2L3 : Real;
      GRID_V_L3L1 : Real;
      GRID_FREQ : Real;
      GRID_MEASUREMENT_OK : Bool;
      GRID_PHASE_LOSS : Bool;          // Alarma pérdida de fase PM5350P
      GRID_ALM_UV : Bool;              // Alarma subtensión PM5350P
      GRID_ALM_OV : Bool;              // Alarma sobretensión PM5350P
      // ---- GENERADORES ----
      GD_READY : Bool;      GD_RUNNING : Bool;     GD_ALARM : Bool;
      GD2_READY : Bool;     GD2_RUNNING : Bool;    GD2_ALARM : Bool;
      // (Eliminados: QT1_STATE/QG1_STATE/QG2_STATE Int — ahora son Bool DI)
      // ---- PARÁMETROS CONFIGURABLES ----
      V_NOM : Real := 380.0;
      V_MIN_PCT : Real := 85.0;
      V_MAX_PCT : Real := 110.0;
      FREQ_NOM : Real := 50.0;
      FREQ_MIN : Real := 49.0;
      FREQ_MAX : Real := 51.0;
      T_OPEN_QT1 : Time := T#3s;
      T_START_GD_DELAY : Time := T#3s;
      T_GD_READY_TIMEOUT : Time := T#30s;
      T_GD_STABILIZATION : Time := T#5s;
      T_CLOSE_QG1 : Time := T#3s;
      T_CLOSE_QG2 : Time := T#3s;
      T_GRID_STABLE : Time := T#120s;
      T_OPEN_QG1 : Time := T#3s;
      T_OPEN_QG2 : Time := T#3s;
      T_CLOSE_QT1 : Time := T#3s;
      T_GD_COOLDOWN : Time := T#60s;
      T_GRID_FAIL_FILTER : Time := T#2s;
      T_CMD_CONFIRM : Time := T#2s;
      // Tiempo mínimo de permanencia en GD antes de permitir retorno a RED
      T_MIN_GD_STAY : Time := T#10m;
   END_VAR

   VAR_OUTPUT 
      STATE : Int;
      STATE_NAME : String[30];
      REQ_SCMTA_OPEN_QT1 : Bool;
      REQ_SCMTA_CLOSE_QT1 : Bool;
      REQ_SCMTA_OPEN_QG1 : Bool;
      REQ_SCMTA_CLOSE_QG1 : Bool;
      REQ_SCMTA_OPEN_QG2 : Bool;
      REQ_SCMTA_CLOSE_QG2 : Bool;
      REQ_SCMTA_OPEN_Q22 : Bool;
      REQ_SCMTA_CLOSE_Q22 : Bool;
      DO_GD_START : Bool;
      DO_GD_STOP : Bool;
      DO_GD2_START : Bool;
      DO_GD2_STOP : Bool;
      IS_ON_GRID : Bool;
      IS_ON_GD : Bool;
      IS_ON_GD1 : Bool;
      IS_ON_GD2 : Bool;
      ACTIVE_GD : Int;
      IS_IN_TRANSFER : Bool;
      IS_FAULT : Bool;
      TRANSFER_TO_GD : Bool;
      GRID_OK : Bool;
      GRID_FAIL : Bool;
      FAULT_CODE : Int;
      ELAPSED_TIME : Time;
      DIAG_LAST_TRANSFER_TIME : Time;
      GD1_AVAILABLE : Bool;
      GD2_AVAILABLE : Bool;
   END_VAR

   VAR 
      statePrev : Int;
      transferStartTime : Time;
      faultCodeLatch : Int;
      gridOkRaw : Bool;
      gridFailRaw : Bool;
      gdReadyStable : Bool;
      activeGDInternal : Int;
      cmdSent : Bool;                 // Flag: pulso de comando ya emitido en estado actual
      timeoutDetected : Bool;
      tonStateTimer {InstructionName := 'TON_TIME'; LibVersion := '1.0'; S7_SetPoint := 'False'} : TON_TIME;
      tonGridFailFilter {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
      tonGridStableFilter {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
      tonGdStabilization {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
      tonFaultAutoRecover {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
      tonMinGdStay {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;  // Tiempo mínimo en GD
   END_VAR

   VAR_TEMP 
      vMin : Real;
      vMax : Real;
      phaseVoltsOk : Bool;
      freqOk : Bool;
      gridAlarmFree : Bool;
   END_VAR

   VAR CONSTANT 
      ST_INIT : Int;
      ST_NORMAL_ON_GRID : Int := 1;
      ST_GRID_FAIL_DETECTED : Int := 2;
      ST_OPEN_QT1 : Int := 3;
      ST_START_GD1_DELAY : Int := 4;
      ST_START_GD1 : Int := 5;
      ST_WAIT_GD1_READY : Int := 6;
      ST_CLOSE_QG1 : Int := 7;
      ST_ON_GD1 : Int := 8;
      ST_GRID_RETURN_DETECTED : Int := 9;
      ST_WAIT_GRID_STABLE : Int := 10;
      ST_OPEN_ACTIVE_GD : Int := 11;
      ST_CLOSE_QT1 : Int := 12;
      ST_GD_COOLDOWN : Int := 13;
      ST_FAULT_LOCKOUT : Int := 14;
      ST_START_GD2_DELAY : Int := 15;
      ST_START_GD2 : Int := 16;
      ST_WAIT_GD2_READY : Int := 17;
      ST_CLOSE_QG2 : Int := 18;
      ST_ON_GD2 : Int := 19;
      ST_OPEN_GD_FOR_SWITCH : Int := 20;
      ST_OPEN_Q22 : Int := 21;
      ST_CLOSE_Q22 : Int := 22;
      FAULT_TIMEOUT_OPEN_QT1 : Int := 101;
      FAULT_TIMEOUT_OPEN_Q22 : Int := 211;
      FAULT_GD1_NOT_READY : Int := 102;
      FAULT_TIMEOUT_CLOSE_QG1 : Int := 103;
      FAULT_TIMEOUT_OPEN_QG1 : Int := 104;
      FAULT_TIMEOUT_CLOSE_QT1 : Int := 105;
      FAULT_GD1_ALARM : Int := 106;
      FAULT_INTERLOCK_VIOLATION : Int := 107;
      FAULT_UNKNOWN_STATE : Int := 108;
      FAULT_GD2_NOT_READY : Int := 202;
      FAULT_TIMEOUT_CLOSE_QG2 : Int := 203;
      FAULT_TIMEOUT_OPEN_QG2 : Int := 204;
      FAULT_GD2_ALARM : Int := 206;
      FAULT_BOTH_GD_UNAVAILABLE : Int := 209;
      FAULT_TIMEOUT_OPEN_SWITCH : Int := 210;
      FAULT_QT1_NOT_REMOTE : Int := 111;
      FAULT_QG1_NOT_REMOTE : Int := 112;
   END_VAR


BEGIN
    // ========================================================================
    // NETWORK 1: CALIDAD DE RED (GRID_OK / GRID_FAIL)
    // Fuente primaria: PM5350P C02 vía Modbus
    // Fuente backup: DI QT1_UV_OV cuando Modbus no disponible
    // ========================================================================
    #vMin := #V_NOM * (#V_MIN_PCT / 100.0);
    #vMax := #V_NOM * (#V_MAX_PCT / 100.0);
    
    IF #GRID_MEASUREMENT_OK THEN
        #phaseVoltsOk := (#GRID_V_L1L2 >= #vMin AND #GRID_V_L1L2 <= #vMax) AND
                         (#GRID_V_L2L3 >= #vMin AND #GRID_V_L2L3 <= #vMax) AND
                         (#GRID_V_L3L1 >= #vMin AND #GRID_V_L3L1 <= #vMax);
        #freqOk        := (#GRID_FREQ >= #FREQ_MIN AND #GRID_FREQ <= #FREQ_MAX);
        // Alarmas del PM5350P: pérdida de fase, UV, OV
        #gridAlarmFree := NOT #GRID_PHASE_LOSS AND NOT #GRID_ALM_UV AND NOT #GRID_ALM_OV;
        #gridOkRaw     := #phaseVoltsOk AND #freqOk AND #gridAlarmFree;
    ELSE
        // Sin comunicación Modbus con PM5350P: fallback a DI backup
        #gridOkRaw := NOT #QT1_UV_OV_DI;
    END_IF;
    #gridFailRaw := NOT #gridOkRaw;
    
    #tonGridFailFilter(IN := #gridFailRaw, PT := #T_GRID_FAIL_FILTER, Q => #GRID_FAIL);
    #tonGridStableFilter(IN := #gridOkRaw, PT := #T_GRID_FAIL_FILTER, Q => #GRID_OK);
    
    
    // ========================================================================
    // NETWORK 2: DISPONIBILIDAD GD
    // ========================================================================
    #GD1_AVAILABLE := NOT #GD_ALARM;
    #GD2_AVAILABLE := #ENABLE_QG2 AND NOT #GD2_ALARM;
    
    
    // ========================================================================
    // NETWORK 3: RESET REQUESTS (pulso 1 scan)
    // ========================================================================
    #REQ_SCMTA_OPEN_QT1  := FALSE; #REQ_SCMTA_CLOSE_QT1 := FALSE;
    #REQ_SCMTA_OPEN_QG1  := FALSE; #REQ_SCMTA_CLOSE_QG1 := FALSE;
    #REQ_SCMTA_OPEN_QG2  := FALSE; #REQ_SCMTA_CLOSE_QG2 := FALSE;
    #REQ_SCMTA_OPEN_Q22  := FALSE; #REQ_SCMTA_CLOSE_Q22 := FALSE;
    
    
    // ========================================================================
    // NETWORK 4: TIMER ESTADO — reinicia al cambiar de estado
    // ========================================================================
    IF #STATE <> #statePrev THEN
        #statePrev       := #STATE;
        #cmdSent         := FALSE;
        #timeoutDetected := FALSE;
        #tonStateTimer(IN := FALSE, PT := T#10m);
    END_IF;
    #tonStateTimer(IN := TRUE, PT := T#10m);
    #ELAPSED_TIME := #tonStateTimer.ET;
    
    
    // ========================================================================
    // NETWORK 5: RESET FORZADO MANUAL — funciona desde cualquier estado
    // ========================================================================
    IF #RESET_FAULT THEN
        #DO_GD_START := FALSE;  #DO_GD_STOP  := FALSE;
        #DO_GD2_START := FALSE; #DO_GD2_STOP := FALSE;
        #IS_IN_TRANSFER  := FALSE;
        #IS_FAULT        := FALSE;
        #FAULT_CODE      := 0;  #faultCodeLatch := 0;
        #TRANSFER_TO_GD  := FALSE;
        #activeGDInternal := 0;
        #cmdSent := FALSE;
        
        IF #GRID_OK AND #QT1_CLOSED THEN
            #STATE := #ST_NORMAL_ON_GRID;
            #IS_ON_GRID := TRUE;
            #IS_ON_GD := FALSE; #IS_ON_GD1 := FALSE; #IS_ON_GD2 := FALSE;
        ELSE
            #STATE := #ST_INIT;
            #IS_ON_GRID := FALSE;
            #IS_ON_GD   := FALSE; #IS_ON_GD1 := FALSE; #IS_ON_GD2 := FALSE;
        END_IF;
        
        #statePrev := -1;
        #tonStateTimer(IN := FALSE, PT := T#10m);
        #ELAPSED_TIME := T#0ms;
    END_IF;
    
    
    // ========================================================================
    // NETWORK 6: MÁQUINA DE ESTADOS SCMTA V4.0
    // ========================================================================
    IF NOT #ENABLE THEN
        RETURN;
    END_IF;
    
    CASE #STATE OF
    
    // ---- 0: INIT — determinar estado inicial ----
    #ST_INIT:
        #IS_ON_GRID := FALSE; #IS_ON_GD := FALSE;
        #IS_ON_GD1  := FALSE; #IS_ON_GD2 := FALSE;
        IF #GRID_OK AND #QT1_CLOSED AND NOT #QT1_FAULT THEN
            #STATE := #ST_NORMAL_ON_GRID;
        ELSIF #QG1_CLOSED AND NOT #QG1_FAULT AND #GD_RUNNING THEN
            #STATE := #ST_ON_GD1; #activeGDInternal := 1;
        ELSIF #ENABLE_QG2 AND #QG2_CLOSED AND NOT #QG2_FAULT AND #GD2_RUNNING THEN
            #STATE := #ST_ON_GD2; #activeGDInternal := 2;
        ELSIF #MODE_AUTO AND #GRID_OK AND #QG1_CLOSED AND NOT #GD_RUNNING THEN
            // Arranque inconsistente: QG1 cerrado sin GD1 en marcha.
            // Abrir QG1 primero para liberar enclavamiento antes de reconectar RED.
            #activeGDInternal := 1;
            #STATE := #ST_OPEN_ACTIVE_GD;
        ELSIF #MODE_AUTO AND #GRID_OK AND #ENABLE_QG2 AND #QG2_CLOSED AND NOT #GD2_RUNNING THEN
            // Arranque inconsistente: QG2 cerrado sin GD2 en marcha.
            #activeGDInternal := 2;
            #STATE := #ST_OPEN_ACTIVE_GD;
        ELSIF #MODE_AUTO AND #GRID_OK THEN
            // Arranque robusto: si QT1 inicia abierto, intentar recuperar RED.
            #STATE := #ST_CLOSE_QT1;
        ELSIF #MODE_AUTO AND #GRID_FAIL THEN
            // Arranque robusto: si la red ya esta en falla, iniciar transferencia.
            #STATE := #ST_GRID_FAIL_DETECTED;
        END_IF;
        
    // ---- 1: NORMAL_ON_GRID ----
    #ST_NORMAL_ON_GRID:
        #IS_ON_GRID := TRUE;
        #IS_ON_GD   := FALSE; #IS_ON_GD1 := FALSE; #IS_ON_GD2 := FALSE;
        #IS_IN_TRANSFER  := FALSE; #TRANSFER_TO_GD := FALSE;
        #DO_GD_START     := FALSE; #DO_GD2_START   := FALSE;
        #activeGDInternal := 0;
        IF #QT1_FAULT THEN
            #faultCodeLatch := #FAULT_TIMEOUT_OPEN_QT1;
            #STATE := #ST_FAULT_LOCKOUT;
        ELSIF #MODE_AUTO AND #GRID_OK AND NOT #QT1_CLOSED THEN
            // Recuperacion en servicio: si pasan a AUTO con QT1 abierto,
            // intentar reconectar RED cerrando QT1.
            #STATE := #ST_CLOSE_QT1;
        ELSIF #MODE_AUTO AND #GRID_FAIL THEN
            #STATE := #ST_GRID_FAIL_DETECTED;
        END_IF;
        
    // ---- 2: GRID_FAIL_DETECTED — abrir QT1 ----
    #ST_GRID_FAIL_DETECTED:
        #IS_IN_TRANSFER := TRUE; #TRANSFER_TO_GD := TRUE;
        IF NOT #QT1_REMOTE THEN
            #faultCodeLatch := #FAULT_QT1_NOT_REMOTE;
            #STATE := #ST_FAULT_LOCKOUT;
        ELSIF NOT #cmdSent THEN
            #REQ_SCMTA_OPEN_QT1 := TRUE;  // Pulso 1 scan → CMD_ARBITER → DO expander
            #cmdSent := TRUE;
        ELSIF NOT #QT1_CLOSED THEN
            #STATE := #ST_OPEN_Q22;                // QT1 abierto → abrir Q22 antes de arrancar GD
        ELSIF #ELAPSED_TIME >= #T_OPEN_QT1 THEN
            #faultCodeLatch := #FAULT_TIMEOUT_OPEN_QT1;
            #STATE := #ST_FAULT_LOCKOUT;
        END_IF;
        
    // ---- 4: DELAY antes de arrancar GD1 ----
    #ST_START_GD1_DELAY:
        IF #ELAPSED_TIME >= #T_START_GD_DELAY THEN
            #STATE := #ST_START_GD1;
        END_IF;
        
    // ---- 5: START_GD1 ----
    #ST_START_GD1:
        IF NOT #GD1_AVAILABLE THEN
            IF #ENABLE_QG2 AND #GD2_AVAILABLE THEN
                #STATE := #ST_START_GD2_DELAY;
            ELSE
                #faultCodeLatch := #FAULT_BOTH_GD_UNAVAILABLE;
                #STATE := #ST_FAULT_LOCKOUT;
            END_IF;
        ELSE
            #DO_GD_START := TRUE; #activeGDInternal := 1;
            #STATE := #ST_WAIT_GD1_READY;
        END_IF;
        
    // ---- 6: WAIT_GD1_READY ----
    #ST_WAIT_GD1_READY:
        #DO_GD_START := TRUE;
        IF #GD_ALARM THEN
            #DO_GD_START := FALSE;
            IF #ENABLE_QG2 AND #GD2_AVAILABLE THEN
                #STATE := #ST_START_GD2_DELAY;
            ELSE
                #faultCodeLatch := #FAULT_GD1_ALARM;
                #STATE := #ST_FAULT_LOCKOUT;
            END_IF;
        ELSIF #GD_READY AND #GD_RUNNING THEN
            #tonGdStabilization(IN := TRUE, PT := #T_GD_STABILIZATION);
            IF #tonGdStabilization.Q THEN
                #STATE := #ST_CLOSE_QG1;
            END_IF;
        ELSE
            #tonGdStabilization(IN := FALSE, PT := #T_GD_STABILIZATION);
            IF #ELAPSED_TIME >= #T_GD_READY_TIMEOUT THEN
                #DO_GD_START := FALSE;
                #faultCodeLatch := #FAULT_GD1_NOT_READY;
                #STATE := #ST_FAULT_LOCKOUT;
            END_IF;
        END_IF;
        
    // ---- 7: CLOSE_QG1 ----
    #ST_CLOSE_QG1:
        #tonGdStabilization(IN := FALSE, PT := #T_GD_STABILIZATION);
        IF NOT #QG1_REMOTE THEN
            #faultCodeLatch := #FAULT_QG1_NOT_REMOTE;
            #STATE := #ST_FAULT_LOCKOUT;
        ELSIF NOT #cmdSent THEN
            #REQ_SCMTA_CLOSE_QG1 := TRUE;
            #cmdSent := TRUE;
        ELSIF #QG1_CLOSED THEN
            #STATE := #ST_ON_GD1;           // QG1 confirmado cerrado
        ELSIF #ELAPSED_TIME >= #T_CLOSE_QG1 THEN
            #faultCodeLatch := #FAULT_TIMEOUT_CLOSE_QG1;
            #STATE := #ST_FAULT_LOCKOUT;
        END_IF;
        
    // ---- 8: ON_GD1 — operando con GD1 ----
    #ST_ON_GD1:
        #IS_ON_GD := TRUE; #IS_ON_GD1 := TRUE; #IS_ON_GD2 := FALSE;
        #IS_ON_GRID := FALSE; #IS_IN_TRANSFER := FALSE;
        #ACTIVE_GD  := 1;    #activeGDInternal := 1;
        // Tiempo mínimo de permanencia en GD (protección motor)
        #tonMinGdStay(IN := TRUE, PT := #T_MIN_GD_STAY);
        IF #GD_ALARM THEN
            // Alarma: no hay tiempo mínimo, la seguridad tiene prioridad
            #tonMinGdStay(IN := FALSE, PT := #T_MIN_GD_STAY);
            IF #ENABLE_QG2 AND #GD2_AVAILABLE THEN
                #STATE := #ST_OPEN_GD_FOR_SWITCH;
            ELSE
                #faultCodeLatch := #FAULT_GD1_ALARM;
                #STATE := #ST_FAULT_LOCKOUT;
            END_IF;
        ELSIF #QG1_FAULT THEN
            #faultCodeLatch := #FAULT_INTERLOCK_VIOLATION;
            #STATE := #ST_FAULT_LOCKOUT;
        ELSIF #ENABLE_AUTO_RETURN AND #GRID_OK AND #tonMinGdStay.Q THEN
            // Retorno a RED solo después de T_MIN_GD_STAY
            #tonMinGdStay(IN := FALSE, PT := #T_MIN_GD_STAY);
            #STATE := #ST_GRID_RETURN_DETECTED;
        END_IF;
        
    // ---- 9: GRID_RETURN_DETECTED ----
    #ST_GRID_RETURN_DETECTED:
        // Al entrar aquí ya se cumplió T_MIN_GD_STAY; resetear timer
        #tonMinGdStay(IN := FALSE, PT := #T_MIN_GD_STAY);
        IF NOT #GRID_OK THEN
            IF #activeGDInternal = 2 THEN
                #STATE := #ST_ON_GD2;
            ELSE
                #STATE := #ST_ON_GD1;
            END_IF;
        ELSE
            #STATE := #ST_WAIT_GRID_STABLE;
        END_IF;
        
    // ---- 10: WAIT_GRID_STABLE — esperar T_GRID_STABLE ----
    #ST_WAIT_GRID_STABLE:
        IF NOT #GRID_OK THEN
            #STATE := #ST_ON_GD1;
        ELSIF #ELAPSED_TIME >= #T_GRID_STABLE THEN
            #STATE := #ST_OPEN_ACTIVE_GD;
        END_IF;
        
    // ---- 11: OPEN_ACTIVE_GD — abrir QGx antes de reconectar RED ----
    #ST_OPEN_ACTIVE_GD:
        #IS_IN_TRANSFER := TRUE;
        IF #activeGDInternal = 1 THEN
            IF NOT #QG1_REMOTE THEN
                #faultCodeLatch := #FAULT_QG1_NOT_REMOTE;
                #STATE := #ST_FAULT_LOCKOUT;
            ELSIF NOT #cmdSent THEN
                #REQ_SCMTA_OPEN_QG1 := TRUE; #cmdSent := TRUE;
            ELSIF NOT #QG1_CLOSED THEN
                #STATE := #ST_CLOSE_QT1;
            ELSIF #ELAPSED_TIME >= #T_OPEN_QG1 THEN
                #faultCodeLatch := #FAULT_TIMEOUT_OPEN_QG1;
                #STATE := #ST_FAULT_LOCKOUT;
            END_IF;
        ELSIF #activeGDInternal = 2 THEN
            IF NOT #cmdSent THEN
                #REQ_SCMTA_OPEN_QG2 := TRUE; #cmdSent := TRUE;
            ELSIF NOT #QG2_CLOSED THEN
                #STATE := #ST_CLOSE_QT1;
            ELSIF #ELAPSED_TIME >= #T_OPEN_QG2 THEN
                #faultCodeLatch := #FAULT_TIMEOUT_OPEN_QG2;
                #STATE := #ST_FAULT_LOCKOUT;
            END_IF;
        END_IF;
        
    // ---- 12: CLOSE_QT1 ----
    #ST_CLOSE_QT1:
        IF NOT #QT1_REMOTE THEN
            #faultCodeLatch := #FAULT_QT1_NOT_REMOTE;
            #STATE := #ST_FAULT_LOCKOUT;
        ELSIF NOT #cmdSent THEN
            #REQ_SCMTA_CLOSE_QT1 := TRUE; #cmdSent := TRUE;
        ELSIF #QT1_CLOSED THEN
            #STATE := #ST_CLOSE_Q22;               // QT1 cerrado → cerrar Q22 antes de cooldown
        ELSIF #ELAPSED_TIME >= #T_CLOSE_QT1 THEN
            #faultCodeLatch := #FAULT_TIMEOUT_CLOSE_QT1;
            #STATE := #ST_FAULT_LOCKOUT;
        END_IF;
        
    // ---- 13: GD_COOLDOWN ----
    #ST_GD_COOLDOWN:
        #IS_ON_GRID := TRUE; #IS_ON_GD := FALSE;
        #IS_ON_GD1  := FALSE; #IS_ON_GD2 := FALSE;
        #IS_IN_TRANSFER := FALSE; #TRANSFER_TO_GD := FALSE;
        #DO_GD_START := FALSE; #DO_GD2_START := FALSE;
        IF #ELAPSED_TIME >= #T_GD_COOLDOWN THEN
            #activeGDInternal := 0; #ACTIVE_GD := 0;
            #STATE := #ST_NORMAL_ON_GRID;
        ELSIF #GRID_FAIL AND #MODE_AUTO THEN
            #STATE := #ST_GRID_FAIL_DETECTED;
        END_IF;
        
    // ---- 14: FAULT_LOCKOUT — espera intervención u auto-recovery ----
    // Auto-recovery prioridad 1: RED estable → retornar a ON_GRID
    // Auto-recovery prioridad 2: solo si hay RESET_FAULT manual
    #ST_FAULT_LOCKOUT:
        #IS_FAULT  := TRUE;
        #FAULT_CODE := #faultCodeLatch;
        #DO_GD_START  := FALSE; #DO_GD2_START := FALSE;
        // Timer estabilización para auto-recovery por RED
        #tonFaultAutoRecover(IN := #GRID_OK, PT := #T_GRID_FAIL_FILTER);
        IF #tonFaultAutoRecover.Q AND #GRID_OK THEN
            #IS_FAULT   := FALSE;
            #FAULT_CODE := 0; #faultCodeLatch := 0;
            IF #QT1_CLOSED THEN
                #STATE := #ST_CLOSE_Q22;   // QT1 ya cerrado → cerrar Q22 antes de reanudar
            ELSE
                #STATE := #ST_CLOSE_QT1;   // Reconectar RED primero, luego ST_CLOSE_Q22
            END_IF;
        END_IF;
        
    // ---- 15-20: Path GD2 (solo si ENABLE_QG2 = TRUE) ----
    #ST_START_GD2_DELAY:
        IF NOT #ENABLE_QG2 THEN
            #faultCodeLatch := #FAULT_BOTH_GD_UNAVAILABLE;
            #STATE := #ST_FAULT_LOCKOUT;
        ELSIF #ELAPSED_TIME >= #T_START_GD_DELAY THEN
            #STATE := #ST_START_GD2;
        END_IF;
        
    #ST_START_GD2:
        IF NOT #ENABLE_QG2 OR NOT #GD2_AVAILABLE THEN
            #faultCodeLatch := #FAULT_BOTH_GD_UNAVAILABLE;
            #STATE := #ST_FAULT_LOCKOUT;
        ELSE
            #DO_GD2_START := TRUE; #activeGDInternal := 2;
            #STATE := #ST_WAIT_GD2_READY;
        END_IF;
        
    #ST_WAIT_GD2_READY:
        #DO_GD2_START := TRUE;
        IF #GD2_ALARM THEN
            #DO_GD2_START := FALSE;
            #faultCodeLatch := #FAULT_GD2_ALARM;
            #STATE := #ST_FAULT_LOCKOUT;
        ELSIF #GD2_READY AND #GD2_RUNNING THEN
            #tonGdStabilization(IN := TRUE, PT := #T_GD_STABILIZATION);
            IF #tonGdStabilization.Q THEN #STATE := #ST_CLOSE_QG2; END_IF;
        ELSE
            #tonGdStabilization(IN := FALSE, PT := #T_GD_STABILIZATION);
            IF #ELAPSED_TIME >= #T_GD_READY_TIMEOUT THEN
                #DO_GD2_START := FALSE;
                #faultCodeLatch := #FAULT_GD2_NOT_READY;
                #STATE := #ST_FAULT_LOCKOUT;
            END_IF;
        END_IF;
        
    #ST_CLOSE_QG2:
        #tonGdStabilization(IN := FALSE, PT := #T_GD_STABILIZATION);
        IF NOT #cmdSent THEN
            #REQ_SCMTA_CLOSE_QG2 := TRUE; #cmdSent := TRUE;
        ELSIF #QG2_CLOSED THEN
            #STATE := #ST_ON_GD2;
        ELSIF #ELAPSED_TIME >= #T_CLOSE_QG2 THEN
            #faultCodeLatch := #FAULT_TIMEOUT_CLOSE_QG2;
            #STATE := #ST_FAULT_LOCKOUT;
        END_IF;
        
    #ST_ON_GD2:
        #IS_ON_GD := TRUE; #IS_ON_GD2 := TRUE; #IS_ON_GD1 := FALSE;
        #IS_ON_GRID := FALSE; #IS_IN_TRANSFER := FALSE; #ACTIVE_GD := 2;
        // Tiempo mínimo de permanencia en GD (protección motor)
        #tonMinGdStay(IN := TRUE, PT := #T_MIN_GD_STAY);
        IF #GD2_ALARM THEN
            // Alarma: no hay tiempo mínimo, la seguridad tiene prioridad
            #tonMinGdStay(IN := FALSE, PT := #T_MIN_GD_STAY);
            #faultCodeLatch := #FAULT_GD2_ALARM;
            #STATE := #ST_FAULT_LOCKOUT;
        ELSIF #QG2_FAULT THEN
            #faultCodeLatch := #FAULT_INTERLOCK_VIOLATION;
            #STATE := #ST_FAULT_LOCKOUT;
        ELSIF #ENABLE_AUTO_RETURN AND #GRID_OK AND #tonMinGdStay.Q THEN
            // Retorno a RED solo después de T_MIN_GD_STAY
            #tonMinGdStay(IN := FALSE, PT := #T_MIN_GD_STAY);
            #STATE := #ST_GRID_RETURN_DETECTED;
        END_IF;
        
    #ST_OPEN_GD_FOR_SWITCH:
        IF NOT #cmdSent THEN
            #REQ_SCMTA_OPEN_QG1 := TRUE; #cmdSent := TRUE;
        ELSIF NOT #QG1_CLOSED THEN
            #DO_GD_START := FALSE; #STATE := #ST_START_GD2_DELAY;
        ELSIF #ELAPSED_TIME >= #T_OPEN_QG1 THEN
            #faultCodeLatch := #FAULT_TIMEOUT_OPEN_SWITCH;
            #STATE := #ST_FAULT_LOCKOUT;
        END_IF;
        
    // ---- 21: OPEN_Q22 — abrir Q22 antes de energizar generador ----
    #ST_OPEN_Q22:
        #IS_IN_TRANSFER := TRUE;
        IF NOT #cmdSent THEN
            #REQ_SCMTA_OPEN_Q22 := TRUE;
            #cmdSent := TRUE;
        ELSIF NOT #Q22_CLOSED THEN
            #STATE := #ST_START_GD1_DELAY;   // Q22 confirmado abierto — continuar secuencia GD
        ELSIF #ELAPSED_TIME >= #T_OPEN_Q22 THEN
            #STATE := #ST_START_GD1_DELAY;   // Timeout (sin DI posicion): continuar de todas formas
        END_IF;

    // ---- 22: CLOSE_Q22 — cerrar Q22 al retornar a RED ----
    #ST_CLOSE_Q22:
        IF #Q22_CLOSED THEN
            #STATE := #ST_GD_COOLDOWN;        // Q22 confirmado cerrado
        ELSIF (#ELAPSED_TIME >= #T_DELAY_CLOSE_Q22) AND (NOT #cmdSent) THEN
            #REQ_SCMTA_CLOSE_Q22 := TRUE;
            #cmdSent := TRUE;
        ELSIF #ELAPSED_TIME >= (#T_DELAY_CLOSE_Q22 + #T_CLOSE_Q22) THEN
            #STATE := #ST_GD_COOLDOWN;        // Timeout (sin DI posicion): continuar igual
        END_IF;

    ELSE:
        #faultCodeLatch := #FAULT_UNKNOWN_STATE;
        #STATE := #ST_FAULT_LOCKOUT;
    END_CASE;
    
    
    // ========================================================================
    // NETWORK 7: SALIDAS GLOBALES — STATE_NAME para HMI
    // ========================================================================
    #ACTIVE_GD := #activeGDInternal;
    CASE #STATE OF
        #ST_INIT:                 #STATE_NAME := 'INIT';
        #ST_NORMAL_ON_GRID:       #STATE_NAME := 'NORMAL_ON_GRID';
        #ST_GRID_FAIL_DETECTED:   #STATE_NAME := 'GRID_FAIL_OPEN_QT1';
        #ST_START_GD1_DELAY:      #STATE_NAME := 'START_GD1_DELAY';
        #ST_START_GD1:            #STATE_NAME := 'START_GD1';
        #ST_WAIT_GD1_READY:       #STATE_NAME := 'WAIT_GD1_READY';
        #ST_CLOSE_QG1:            #STATE_NAME := 'CLOSE_QG1';
        #ST_ON_GD1:               #STATE_NAME := 'ON_GD1';
        #ST_GRID_RETURN_DETECTED: #STATE_NAME := 'GRID_RETURN';
        #ST_WAIT_GRID_STABLE:     #STATE_NAME := 'WAIT_GRID_STABLE';
        #ST_OPEN_ACTIVE_GD:       #STATE_NAME := 'OPEN_ACTIVE_GD';
        #ST_CLOSE_QT1:            #STATE_NAME := 'CLOSE_QT1';
        #ST_GD_COOLDOWN:          #STATE_NAME := 'GD_COOLDOWN';
        #ST_FAULT_LOCKOUT:        #STATE_NAME := 'FAULT_LOCKOUT';
        #ST_START_GD2_DELAY:      #STATE_NAME := 'START_GD2_DELAY';
        #ST_START_GD2:            #STATE_NAME := 'START_GD2';
        #ST_WAIT_GD2_READY:       #STATE_NAME := 'WAIT_GD2_READY';
        #ST_CLOSE_QG2:            #STATE_NAME := 'CLOSE_QG2';
        #ST_ON_GD2:               #STATE_NAME := 'ON_GD2';
        #ST_OPEN_GD_FOR_SWITCH:   #STATE_NAME := 'OPEN_GD_FOR_SWITCH';
        #ST_OPEN_Q22:             #STATE_NAME := 'OPEN_Q22';
        #ST_CLOSE_Q22:            #STATE_NAME := 'CLOSE_Q22';
    ELSE
        #STATE_NAME := 'UNKNOWN';
    END_CASE;
    
END_FUNCTION_BLOCK
