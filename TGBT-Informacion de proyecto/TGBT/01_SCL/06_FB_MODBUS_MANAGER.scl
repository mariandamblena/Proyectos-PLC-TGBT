FUNCTION_BLOCK "06_FB_MODBUS_MANAGER"
{ S7_Optimized_Access := 'FALSE' }
// ============================================================================
// FB: 06_FB_MODBUS_MANAGER  -- Gestor Modbus RTU  V6.0
// ============================================================================
// CAMBIO V6.0 (alineado al test que funciono):
//   - MB_COMM_LOAD con salidas explicitas DONE/ERROR/STATUS a outputs del FB.
//   - MB_MASTER con REQ sostenido (TRUE fijo cuando ENABLE y puerto OK).
//   - Avance de esclavo por evento (flanco) DONE/ERROR, no por estado/temporizador.
//   - Sin polling timers; MB_MASTER maneja BLOCKED_PROC_TIMEOUT internamente.
// ============================================================================
VERSION : 0.1
   VAR_INPUT
      ENABLE         : Bool := TRUE;
      FIRST_SCAN     : Bool;         // %M800.0 (primer ciclo de scan)
      // Slave IDs de los 7 medidores
        SLAVE_C02      : UInt := 1;
        SLAVE_C01_GD1  : UInt := 2;
        SLAVE_C01_GD2  : UInt := 3;
        SLAVE_C03      : UInt := 4;
        SLAVE_C04      : UInt := 5;
        SLAVE_C05      : UInt := 6;
        SLAVE_C06      : UInt := 7;
      // Configuracion puerto serial
      PORT_ID        : UInt  := 271;    // HW ID CB 1241 RS485
      BAUD_RATE      : UDInt := 19200;
      PARITY         : UInt  := 2;      // 2 = Even
      RESP_TIMEOUT   : UInt  := 1000;   // [ms] timeout respuesta esclavo
      MAX_RETRIES    : Int   := 3;
   END_VAR

   VAR_OUTPUT
        PM_I_L1        : Array[1..7] of Real;
        PM_I_L2        : Array[1..7] of Real;
        PM_I_L3        : Array[1..7] of Real;
      PM_V_L1L2      : Array[1..7] of Real;
      PM_V_L2L3      : Array[1..7] of Real;
      PM_V_L3L1      : Array[1..7] of Real;
      PM_FREQ        : Array[1..7] of Real;
      PM_P_TOTAL     : Array[1..7] of Real;
      PM_ALARM       : Array[1..7] of Bool;
      PM_COMM_OK     : Array[1..7] of Bool;
      COMM_OK        : Bool;
      GRID_MEAS_OK   : Bool;
      ACTIVE_DEVICE  : String[20];
      BUSY           : Bool;
      ERROR          : Bool;
      COMM_ERRORS    : Int;
      PORT_CFG_DONE  : Bool;
      PORT_CFG_ERROR : Bool;
      PORT_CFG_STATUS : Word;
   END_VAR

   VAR
        pollIndex         : Int  := 1;    // Indice activo 1..7
      retryCount        : Int;
      currentSlaveAddr  : UInt;
      portConfigured    : Bool;
      initialized       : Bool;         // Primer slave asignado al arrancar
      mbMasterReq       : Bool;
      mbDone            : Bool;
      mbBusy            : Bool;
      mbError           : Bool;
      mbStatus          : Word;
        doneLastScan      : Bool;
        errorLastScan     : Bool;
      MB_MASTER_Inst    {InstructionName := 'MB_MASTER';    LibVersion := '1.4'} : MB_MASTER;
      MB_COMM_LOAD_Inst {InstructionName := 'MB_COMM_LOAD'; LibVersion := '1.2'} : MB_COMM_LOAD;
      // Buffer de recepcion: 120 registros holding (DATA_ADDR=43000 = reg 3000 del PM)
      // Array of Word requerido por DATA_PTR de MB_MASTER (S7-300/400 compatible)
      rxBuffer          : Array[0..119] of Word;
   END_VAR

   VAR CONSTANT
      N_DEVICES    : Int   := 7;
      MB_DATA_ADDR : UDInt := 43000;  // Modbus addr 43000 = FC03 holding reg 3000
      MB_DATA_LEN  : UInt  := 120;
      MB_MODE_READ : USInt := 0;      // FC03 Read Holding Registers
   END_VAR


BEGIN
    // ========================================================================
    // MB_COMM_LOAD — configurar puerto una sola vez en FirstScan
    // Identico al Ladder funcional: PORT=271, BAUD=19200, PARITY=2(Even)
    // ========================================================================
    #MB_COMM_LOAD_Inst(REQ        := #FIRST_SCAN AND NOT #portConfigured,
                       "PORT"     := #PORT_ID,
                       BAUD       := #BAUD_RATE,
                       PARITY     := #PARITY,
                       FLOW_CTRL  := 0,
                       RTS_ON_DLY := 0,
                       RTS_OFF_DLY := 0,
                       RESP_TO    := #RESP_TIMEOUT,
                       DONE       => #PORT_CFG_DONE,
                       ERROR      => #PORT_CFG_ERROR,
                       STATUS     => #PORT_CFG_STATUS,
                       MB_DB      := #MB_MASTER_Inst);

    IF #PORT_CFG_DONE AND NOT #PORT_CFG_ERROR THEN
        #portConfigured := TRUE;
    ELSIF #PORT_CFG_ERROR THEN
        #portConfigured := FALSE;
    END_IF;


    // ========================================================================
    // INICIALIZACION: asignar primer slave al arranque
    // ========================================================================
    IF #portConfigured AND NOT #initialized THEN
        #pollIndex        := 1;
        #currentSlaveAddr := #SLAVE_C02;
        #ACTIVE_DEVICE    := 'C02_RED';
        #initialized      := TRUE;
    END_IF;

    IF #pollIndex < 1 OR #pollIndex > #N_DEVICES THEN
        #pollIndex := 1;
    END_IF;

    // Resolver slave activo segun indice actual
    CASE #pollIndex OF
        1: #currentSlaveAddr := #SLAVE_C02;     #ACTIVE_DEVICE := 'C02_RED';
        2: #currentSlaveAddr := #SLAVE_C01_GD1; #ACTIVE_DEVICE := 'C01_GD1';
        3: #currentSlaveAddr := #SLAVE_C01_GD2; #ACTIVE_DEVICE := 'C01_GD2';
        4: #currentSlaveAddr := #SLAVE_C03;     #ACTIVE_DEVICE := 'C03';
        5: #currentSlaveAddr := #SLAVE_C04;     #ACTIVE_DEVICE := 'C04';
        6: #currentSlaveAddr := #SLAVE_C05;     #ACTIVE_DEVICE := 'C05';
        7: #currentSlaveAddr := #SLAVE_C06;     #ACTIVE_DEVICE := 'C06_Q22';
    ELSE
        #currentSlaveAddr := #SLAVE_C02;
        #ACTIVE_DEVICE := 'C02_RED';
    END_CASE;


    // ========================================================================
    // REQ SIEMPRE ACTIVO — patron identico al Ladder funcional (AlwaysTrue)
    // MB_MASTER gestiona BLOCKED_PROC_TIMEOUT internamente entre transacciones.
    // No usar pulso/flanco: el medidor puede tardar varios segundos en responder.
    // ========================================================================
    #mbMasterReq := #ENABLE AND #portConfigured;


    // ========================================================================
    // MB_MASTER — llamar SIEMPRE en cada scan
    // REQ sostenido (patron validado en test y Ladder funcional)
    // ========================================================================
    #MB_MASTER_Inst(REQ       := #mbMasterReq,
                    MB_ADDR   := #currentSlaveAddr,
                    MODE      := #MB_MODE_READ,
                    DATA_ADDR := #MB_DATA_ADDR,
                    DATA_LEN  := #MB_DATA_LEN,
                    DONE      => #mbDone,
                    BUSY      => #mbBusy,
                    ERROR     => #mbError,
                    STATUS    => #mbStatus,
                    DATA_PTR  := #rxBuffer);

    #BUSY := #mbBusy;


    // ========================================================================
    // PROCESAMIENTO DE RESPUESTAS — por flanco DONE/ERROR
    // ========================================================================
    IF #ENABLE AND #portConfigured THEN

        IF #mbDone AND NOT #doneLastScan AND NOT #mbError THEN
            // -----------------------------------------------------------------
            // Lectura exitosa: parsear rxBuffer y avanzar al siguiente slave
            // -----------------------------------------------------------------
            // Fuente: PM51xx_PM53xx_PMC Register List (Schneider)
            // Todos los valores son FLOAT32 (2 words, big-endian: high word primero)
            // Mapa de offsets (offset = registro - 3000):
            //   [0..1]   reg 3000  Current A (I_L1)      [A]
            //   [2..3]   reg 3002  Current B (I_L2)      [A]
            //   [4..5]   reg 3004  Current C (I_L3)      [A]
            //   [20..21] reg 3020  V_L1L2 (Voltage A-B)  [V]
            //   [22..23] reg 3022  V_L2L3 (Voltage B-C)  [V]
            //   [24..25] reg 3024  V_L3L1 (Voltage C-A)  [V]
            //   [60..61] reg 3060  Active Power Total     [kW]
            //   [110..111] reg 3110  Frequency            [Hz]
            // -----------------------------------------------------------------
            #PM_I_L1[#pollIndex] := DWORD_TO_REAL(
                SHL(IN := WORD_TO_DWORD(#rxBuffer[0]), N := 16)
                OR  WORD_TO_DWORD(#rxBuffer[1]));
            #PM_I_L2[#pollIndex] := DWORD_TO_REAL(
                SHL(IN := WORD_TO_DWORD(#rxBuffer[2]), N := 16)
                OR  WORD_TO_DWORD(#rxBuffer[3]));
            #PM_I_L3[#pollIndex] := DWORD_TO_REAL(
                SHL(IN := WORD_TO_DWORD(#rxBuffer[4]), N := 16)
                OR  WORD_TO_DWORD(#rxBuffer[5]));
            #PM_V_L1L2[#pollIndex] := DWORD_TO_REAL(
                SHL(IN := WORD_TO_DWORD(#rxBuffer[20]), N := 16)
                OR  WORD_TO_DWORD(#rxBuffer[21]));
            #PM_V_L2L3[#pollIndex] := DWORD_TO_REAL(
                SHL(IN := WORD_TO_DWORD(#rxBuffer[22]), N := 16)
                OR  WORD_TO_DWORD(#rxBuffer[23]));
            #PM_V_L3L1[#pollIndex] := DWORD_TO_REAL(
                SHL(IN := WORD_TO_DWORD(#rxBuffer[24]), N := 16)
                OR  WORD_TO_DWORD(#rxBuffer[25]));
            #PM_P_TOTAL[#pollIndex] := DWORD_TO_REAL(
                SHL(IN := WORD_TO_DWORD(#rxBuffer[60]), N := 16)
                OR  WORD_TO_DWORD(#rxBuffer[61]));
            #PM_FREQ[#pollIndex] := DWORD_TO_REAL(
                SHL(IN := WORD_TO_DWORD(#rxBuffer[110]), N := 16)
                OR  WORD_TO_DWORD(#rxBuffer[111]));

            #PM_COMM_OK[#pollIndex] := TRUE;
            #COMM_OK                := TRUE;
            #ERROR                  := FALSE;
            #retryCount             := 0;

            IF #pollIndex = 1 THEN
                #GRID_MEAS_OK := TRUE;
            END_IF;

            // Avanzar al siguiente slave para la proxima transaccion
            #pollIndex := #pollIndex + 1;
            IF #pollIndex > #N_DEVICES THEN #pollIndex := 1; END_IF;

        ELSIF #mbError AND NOT #errorLastScan THEN
            // -----------------------------------------------------------------
            // Error de comunicacion: reintentar MAX_RETRIES veces,
            // luego avanzar al siguiente slave igualmente
            // -----------------------------------------------------------------
            #ERROR       := TRUE;
            #COMM_ERRORS := #COMM_ERRORS + 1;
            #retryCount  := #retryCount + 1;

            IF #retryCount >= #MAX_RETRIES THEN
                // Marcar falla de este medidor y continuar al siguiente
                #PM_COMM_OK[#pollIndex] := FALSE;
                IF #pollIndex = 1 THEN
                    #GRID_MEAS_OK := FALSE;
                END_IF;
                #retryCount := 0;

                #pollIndex := #pollIndex + 1;
                IF #pollIndex > #N_DEVICES THEN #pollIndex := 1; END_IF;
            END_IF;
        END_IF;

    ELSE
        // ENABLE=FALSE o puerto no configurado
        #mbMasterReq := FALSE;
        #BUSY        := FALSE;
        #retryCount  := 0;
        IF NOT #ENABLE THEN
            #COMM_OK      := FALSE;
            #GRID_MEAS_OK := FALSE;
            #ERROR        := FALSE;
        END_IF;
    END_IF;

    #doneLastScan  := #mbDone;
    #errorLastScan := #mbError;

END_FUNCTION_BLOCK
