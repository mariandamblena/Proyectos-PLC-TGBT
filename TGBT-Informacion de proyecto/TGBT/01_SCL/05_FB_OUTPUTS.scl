FUNCTION_BLOCK "05_FB_OUTPUTS"
{ S7_Optimized_Access := 'TRUE' }
// ============================================================================
// FB: 05_FB_OUTPUTS  -- Gestion Pilotos y HMI  V4.0
// ============================================================================
// CAMBIO ALCANCE V4:
//   - Usar QT1_CLOSED/QT1_FAULT (Bool) en lugar de QT1_STATE (Int)
//   - Eliminar CHARGING outputs (sin estado Modbus MTZ en V4)
//   - Eliminar feeder arrays de pilotos y HMI
//   - Agregar piloto Q22 (OPEN / CLOSED / FAULT)
//   - Actualizar textos alarma: codigos 111 (QT1 no REMOTO), 112 (QG1 no REMOTO)
// ============================================================================
VERSION : 0.1
   VAR_INPUT
      IS_ON_GRID   : Bool;
      IS_ON_GD     : Bool;
      IS_IN_TRANSFER : Bool;
      IS_FAULT     : Bool;
      STATE        : Int;
      STATE_NAME   : String[30];
      FAULT_CODE   : Int;
      // Posicion y estado de interruptores (Bool de DI)
      QT1_CLOSED   : Bool;
      QT1_FAULT    : Bool;
      QG1_CLOSED   : Bool;
      QG1_FAULT    : Bool;
      QG2_CLOSED   : Bool;
      QG2_FAULT    : Bool;
      Q22_CLOSED   : Bool;   // DI posicion Q22
      Q22_FAULT    : Bool;
      // Alarmas
      ALM_INTERLOCK_VIOLATION : Bool;
      BLOCK_INTERLOCK : Bool;
      GRID_FAIL    : Bool;
      GD_ALARM     : Bool;
      GD2_ALARM    : Bool;
      ACK_ALARM    : Bool;
   END_VAR

   VAR_OUTPUT
      DO_PILOT_ON_GRID   : Bool;
      DO_PILOT_ON_GD     : Bool;
      DO_PILOT_FAULT     : Bool;

      DO_PILOT_QT1_OPEN   : Bool;
      DO_PILOT_QT1_CLOSED : Bool;
      DO_PILOT_QT1_FAULT  : Bool;

      DO_PILOT_QG1_OPEN   : Bool;
      DO_PILOT_QG1_CLOSED : Bool;
      DO_PILOT_QG1_FAULT  : Bool;

      DO_PILOT_QG2_OPEN   : Bool;
      DO_PILOT_QG2_CLOSED : Bool;
      DO_PILOT_QG2_FAULT  : Bool;

      DO_PILOT_Q22_OPEN   : Bool;
      DO_PILOT_Q22_CLOSED : Bool;
      DO_PILOT_Q22_FAULT  : Bool;

      DO_ALARM_BEACON    : Bool;
      HMI_STATUS_TEXT    : String[50];
      HMI_ALARM_ACTIVE   : Bool;
      HMI_ALARM_TEXT     : String[100];
   END_VAR

   VAR
      alarmActive      : Bool;
      alarmAcknowledged : Bool;
      alarmText        : String[100];
      tonBlink         {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
      blinkState       : Bool;
      blinkToggle      : Bool;
      memAckAlarm      : Bool;
   END_VAR

   VAR CONSTANT
      BLINK_TIME : Time := T#500ms;
   END_VAR


BEGIN
    // ========================================================================
    // NETWORK 1: GENERADOR DE PARPADEO (500ms)
    // ========================================================================
    #tonBlink(IN := NOT #blinkToggle, PT := #BLINK_TIME);
    IF #tonBlink.Q THEN
        #blinkState  := NOT #blinkState;
        #blinkToggle := TRUE;
    END_IF;
    IF #blinkToggle THEN #blinkToggle := FALSE; END_IF;


    // ========================================================================
    // NETWORK 2: PILOTOS DE ESTADO SISTEMA
    // ========================================================================
    #DO_PILOT_ON_GRID := #IS_ON_GRID AND NOT #IS_FAULT;
    #DO_PILOT_ON_GD   := #IS_ON_GD AND NOT #IS_FAULT;
    #DO_PILOT_FAULT   := #IS_FAULT;


    // ========================================================================
    // NETWORK 3: PILOTOS INTERRUPTORES
    // Logica: CLOSED fijo si cerrado, OPEN fijo si abierto, FAULT si falla
    // En transferencia: parpadeo alterno
    // ========================================================================
    // ---- QT1 ----
    IF #QT1_FAULT THEN
        #DO_PILOT_QT1_FAULT  := TRUE;
        #DO_PILOT_QT1_CLOSED := #blinkState;
        #DO_PILOT_QT1_OPEN   := NOT #blinkState;
    ELSIF #QT1_CLOSED THEN
        #DO_PILOT_QT1_OPEN   := FALSE;
        #DO_PILOT_QT1_CLOSED := TRUE;
        #DO_PILOT_QT1_FAULT  := FALSE;
    ELSE
        #DO_PILOT_QT1_OPEN   := TRUE;
        #DO_PILOT_QT1_CLOSED := FALSE;
        #DO_PILOT_QT1_FAULT  := FALSE;
    END_IF;

    // ---- QG1 ----
    IF #QG1_FAULT THEN
        #DO_PILOT_QG1_FAULT  := TRUE;
        #DO_PILOT_QG1_CLOSED := #blinkState;
        #DO_PILOT_QG1_OPEN   := NOT #blinkState;
    ELSIF #QG1_CLOSED THEN
        #DO_PILOT_QG1_OPEN   := FALSE;
        #DO_PILOT_QG1_CLOSED := TRUE;
        #DO_PILOT_QG1_FAULT  := FALSE;
    ELSE
        #DO_PILOT_QG1_OPEN   := TRUE;
        #DO_PILOT_QG1_CLOSED := FALSE;
        #DO_PILOT_QG1_FAULT  := FALSE;
    END_IF;

    // ---- QG2 ---- (no instalado en V4 => todos apagados si QG2_CLOSED=FALSE)
    IF #QG2_FAULT THEN
        #DO_PILOT_QG2_FAULT  := TRUE;
        #DO_PILOT_QG2_CLOSED := #blinkState;
        #DO_PILOT_QG2_OPEN   := NOT #blinkState;
    ELSIF #QG2_CLOSED THEN
        #DO_PILOT_QG2_OPEN   := FALSE;
        #DO_PILOT_QG2_CLOSED := TRUE;
        #DO_PILOT_QG2_FAULT  := FALSE;
    ELSE
        #DO_PILOT_QG2_OPEN   := TRUE;
        #DO_PILOT_QG2_CLOSED := FALSE;
        #DO_PILOT_QG2_FAULT  := FALSE;
    END_IF;

    // ---- Q22 ----
    IF #Q22_FAULT THEN
        #DO_PILOT_Q22_FAULT  := TRUE;
        #DO_PILOT_Q22_CLOSED := #blinkState;
        #DO_PILOT_Q22_OPEN   := NOT #blinkState;
    ELSIF #Q22_CLOSED THEN
        #DO_PILOT_Q22_OPEN   := FALSE;
        #DO_PILOT_Q22_CLOSED := TRUE;
        #DO_PILOT_Q22_FAULT  := FALSE;
    ELSE
        #DO_PILOT_Q22_OPEN   := TRUE;
        #DO_PILOT_Q22_CLOSED := FALSE;
        #DO_PILOT_Q22_FAULT  := FALSE;
    END_IF;


    // ========================================================================
    // NETWORK 4: GESTION DE ALARMAS
    // ========================================================================
    #alarmActive := #IS_FAULT OR #ALM_INTERLOCK_VIOLATION OR #GD_ALARM OR #GD2_ALARM;

    IF #IS_FAULT THEN
        CASE #FAULT_CODE OF
            101: #alarmText := 'TIMEOUT: Abrir QT1 fallido';
            102: #alarmText := 'TIMEOUT: GD no alcanzo READY';
            103: #alarmText := 'TIMEOUT: Cerrar QG1 fallido';
            104: #alarmText := 'TIMEOUT: Abrir QG1 fallido';
            105: #alarmText := 'TIMEOUT: Cerrar QT1 fallido';
            106: #alarmText := 'ALARMA: Falla Grupo Diesel GD1';
            107: #alarmText := 'ALARMA: Violacion enclavamiento';
            108: #alarmText := 'FALLA: Estado maquina desconocido';
            109: #alarmText := 'TIMEOUT: Cerrar QG2 fallido';
            110: #alarmText := 'FALLA: Ambos GD no disponibles';
            111: #alarmText := 'FALLA: QT1 no esta en REMOTO';
            112: #alarmText := 'FALLA: QG1 no esta en REMOTO';
        ELSE
            #alarmText := 'FALLA: Codigo desconocido';
        END_CASE;
    ELSIF #ALM_INTERLOCK_VIOLATION THEN
        #alarmText := 'ALARMA: Multiples fuentes cerradas';
    ELSIF #GD_ALARM THEN
        #alarmText := 'ALARMA: Falla Grupo Diesel 1';
    ELSIF #GD2_ALARM THEN
        #alarmText := 'ALARMA: Falla Grupo Diesel 2';
    ELSE
        #alarmText := '';
    END_IF;

    // Reconocimiento alarma (R_TRIG)
    IF #ACK_ALARM AND NOT #memAckAlarm THEN
        #alarmAcknowledged := TRUE;
    END_IF;
    #memAckAlarm := #ACK_ALARM;
    IF NOT #alarmActive THEN
        #alarmAcknowledged := FALSE;
    END_IF;


    // ========================================================================
    // NETWORK 5: BALIZA Y HMI
    // ========================================================================
    #DO_ALARM_BEACON  := #alarmActive;
    #HMI_STATUS_TEXT  := #STATE_NAME;
    #HMI_ALARM_ACTIVE := #alarmActive;
    #HMI_ALARM_TEXT   := #alarmText;

END_FUNCTION_BLOCK
