FUNCTION_BLOCK "05_FB_OUTPUTS"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      IS_ON_GRID : Bool;
      IS_ON_GD : Bool;
      IS_IN_TRANSFER : Bool;
      IS_FAULT : Bool;
      STATE : Int;
      STATE_NAME : String[30];
      FAULT_CODE : Int;
      QT1_STATE : Int;
      QG1_STATE : Int;
      QG2_STATE : Int;
      QT1_TRIPPED : Bool;
      QG1_TRIPPED : Bool;
      QG2_TRIPPED : Bool;
      QT1_READY : Bool;
      QG1_READY : Bool;
      QG2_READY : Bool;
      FEEDER_STATE : Array[1..19] of Int;
      FEEDER_TRIPPED : Array[1..19] of Bool;
      FEEDER_ALARM : Array[1..19] of Bool;
      ALM_INTERLOCK_VIOLATION : Bool;
      BLOCK_INTERLOCK : Bool;
      GRID_FAIL : Bool;
      GD_ALARM : Bool;
      GD2_ALARM : Bool;
      SHED_ACTIVE : Bool;
      FEEDERS_SHED : Int;
      ACK_ALARM : Bool;
   END_VAR

   VAR_OUTPUT 
      DO_PILOT_ON_GRID : Bool;
      DO_PILOT_ON_GD : Bool;
      DO_PILOT_FAULT : Bool;
      DO_PILOT_SHED : Bool;
      DO_PILOT_QT1_OPEN : Bool;
      DO_PILOT_QT1_CLOSED : Bool;
      DO_PILOT_QT1_FAULT : Bool;
      DO_PILOT_QT1_CHARGING : Bool;
      DO_PILOT_QG1_OPEN : Bool;
      DO_PILOT_QG1_CLOSED : Bool;
      DO_PILOT_QG1_FAULT : Bool;
      DO_PILOT_QG1_CHARGING : Bool;
      DO_PILOT_QG2_OPEN : Bool;
      DO_PILOT_QG2_CLOSED : Bool;
      DO_PILOT_QG2_FAULT : Bool;
      DO_PILOT_QG2_CHARGING : Bool;
      DO_PILOT_FEEDER_FAULT : Array[1..19] of Bool;
      DO_PILOT_FEEDER_CLOSED : Array[1..19] of Bool;
      DO_PILOT_FEEDER_OPEN : Array[1..19] of Bool;
      DO_ALARM_BEACON : Bool;
      HMI_STATUS_TEXT : String[50];
      HMI_ALARM_ACTIVE : Bool;
      HMI_ALARM_TEXT : String[100];
      HMI_FEEDER_OPEN : Array[1..19] of Bool;
      HMI_FEEDER_CLOSED : Array[1..19] of Bool;
      HMI_FEEDER_TRIPPED : Array[1..19] of Bool;
      HMI_FEEDER_ALARM : Array[1..19] of Bool;
   END_VAR

   VAR 
      alarmActive : Bool;
      alarmAcknowledged : Bool;
      alarmText : String[100];
      tonBlink {InstructionName := 'TON_TIME'; LibVersion := '1.0'; S7_SetPoint := 'False'} : TON_TIME;
      blinkState : Bool;
      blinkToggle : Bool;
      rtAckAlarm : Bool;
      memAckAlarm : Bool;
      i : Int;
   END_VAR

   VAR CONSTANT 
      BLINK_TIME : Time := T#500ms;
      N_FEEDERS : Int := 19;
   END_VAR


BEGIN
	    // NETWORK 1: PARPADEO (generador 500ms ON / 500ms OFF)
	    // ========================================================================
	    
	    #tonBlink(IN := NOT #blinkToggle, PT := #BLINK_TIME);
	    IF #tonBlink.Q THEN
	        #blinkState := NOT #blinkState;
	        #blinkToggle := TRUE;
	    END_IF;
	    IF #blinkToggle THEN
	        #blinkToggle := FALSE;
	    END_IF;
	    
	    
	    // ========================================================================
	    // NETWORK 2: PILOTOS DE ESTADO SISTEMA
	    // ========================================================================
	    
	    // LED "EN RED" (verde fijo)
	    #DO_PILOT_ON_GRID := #IS_ON_GRID AND NOT #IS_FAULT;
	    
	    // LED "EN GRUPO" (amarillo fijo)
	    #DO_PILOT_ON_GD := #IS_ON_GD AND NOT #IS_FAULT;
	    
	    // LED "FALLA" (rojo fijo)
	    #DO_PILOT_FAULT := #IS_FAULT;
	    
	    // LED "DESLASTRE ACTIVO" (amarillo fijo)
	    #DO_PILOT_SHED := #SHED_ACTIVE;
	    
	    
	    // ========================================================================
	    // NETWORK 3: PILOTOS INTERRUPTORES QT1/QG1/QG2
	    // ========================================================================
	    // STATE: 0=Abierto, 1=Cerrado, 2=Desconocido, 3=Transición
	    // En transición: ambos pilotos parpadean alternado
	    // Si TRIPPED: rojo fijo + verde parpadea
	    // FAULT (ámbar): se enciende cuando TRIPPED = TRUE
	    // CHARGING (blanco): se enciende cuando READY = TRUE (Modbus PF bit)
	    
	    // ---- QT1 ----
	    IF #QT1_TRIPPED THEN
	        #DO_PILOT_QT1_CLOSED := TRUE;
	        #DO_PILOT_QT1_OPEN := #blinkState;
	    ELSIF #QT1_STATE = 0 THEN
	        #DO_PILOT_QT1_OPEN := TRUE;
	        #DO_PILOT_QT1_CLOSED := FALSE;
	    ELSIF #QT1_STATE = 1 THEN
	        #DO_PILOT_QT1_OPEN := FALSE;
	        #DO_PILOT_QT1_CLOSED := TRUE;
	    ELSIF #QT1_STATE = 3 THEN
	        #DO_PILOT_QT1_OPEN := #blinkState;
	        #DO_PILOT_QT1_CLOSED := NOT #blinkState;
	    ELSE
	        #DO_PILOT_QT1_OPEN := FALSE;
	        #DO_PILOT_QT1_CLOSED := FALSE;
	    END_IF;
	    
	    #DO_PILOT_QT1_FAULT := #QT1_TRIPPED;
	    #DO_PILOT_QT1_CHARGING := #QT1_READY;
	    
	    // ---- QG1 ----
	    IF #QG1_TRIPPED THEN
	        #DO_PILOT_QG1_CLOSED := TRUE;
	        #DO_PILOT_QG1_OPEN := #blinkState;
	    ELSIF #QG1_STATE = 0 THEN
	        #DO_PILOT_QG1_OPEN := TRUE;
	        #DO_PILOT_QG1_CLOSED := FALSE;
	    ELSIF #QG1_STATE = 1 THEN
	        #DO_PILOT_QG1_OPEN := FALSE;
	        #DO_PILOT_QG1_CLOSED := TRUE;
	    ELSIF #QG1_STATE = 3 THEN
	        #DO_PILOT_QG1_OPEN := #blinkState;
	        #DO_PILOT_QG1_CLOSED := NOT #blinkState;
	    ELSE
	        #DO_PILOT_QG1_OPEN := FALSE;
	        #DO_PILOT_QG1_CLOSED := FALSE;
	    END_IF;
	    
	    #DO_PILOT_QG1_FAULT := #QG1_TRIPPED;
	    #DO_PILOT_QG1_CHARGING := #QG1_READY;
	    
	    // ---- QG2 ----
	    IF #QG2_TRIPPED THEN
	        #DO_PILOT_QG2_CLOSED := TRUE;
	        #DO_PILOT_QG2_OPEN := #blinkState;
	    ELSIF #QG2_STATE = 0 THEN
	        #DO_PILOT_QG2_OPEN := TRUE;
	        #DO_PILOT_QG2_CLOSED := FALSE;
	    ELSIF #QG2_STATE = 1 THEN
	        #DO_PILOT_QG2_OPEN := FALSE;
	        #DO_PILOT_QG2_CLOSED := TRUE;
	    ELSIF #QG2_STATE = 3 THEN
	        #DO_PILOT_QG2_OPEN := #blinkState;
	        #DO_PILOT_QG2_CLOSED := NOT #blinkState;
	    ELSE
	        #DO_PILOT_QG2_OPEN := FALSE;
	        #DO_PILOT_QG2_CLOSED := FALSE;
	    END_IF;
	    
	    #DO_PILOT_QG2_FAULT := #QG2_TRIPPED;
	    #DO_PILOT_QG2_CHARGING := #QG2_READY;
	    
	    
	    // ========================================================================
	    // NETWORK 4: PILOTOS FEEDERS (19 NSX) + SEÑALES HMI
	    // ========================================================================
	    // 3 pilotos físicos por feeder: Fault (ámbar), Closed (rojo), Open (verde)
	    // + consolidación HMI
	    
	    FOR #i := 1 TO #N_FEEDERS DO
	        // Pilotos físicos feeders
	        #DO_PILOT_FEEDER_FAULT[#i] := #FEEDER_TRIPPED[#i] OR #FEEDER_ALARM[#i];
	        
	        IF #FEEDER_TRIPPED[#i] THEN
	            // Tripped: rojo fijo + verde parpadea
	            #DO_PILOT_FEEDER_CLOSED[#i] := TRUE;
	            #DO_PILOT_FEEDER_OPEN[#i] := #blinkState;
	        ELSIF #FEEDER_STATE[#i] = 0 THEN
	            // Abierto: verde fijo
	            #DO_PILOT_FEEDER_OPEN[#i] := TRUE;
	            #DO_PILOT_FEEDER_CLOSED[#i] := FALSE;
	        ELSIF #FEEDER_STATE[#i] = 1 THEN
	            // Cerrado: rojo fijo
	            #DO_PILOT_FEEDER_OPEN[#i] := FALSE;
	            #DO_PILOT_FEEDER_CLOSED[#i] := TRUE;
	        ELSE
	            // Desconocido: ambos apagados
	            #DO_PILOT_FEEDER_OPEN[#i] := FALSE;
	            #DO_PILOT_FEEDER_CLOSED[#i] := FALSE;
	        END_IF;
	        
	        // Señales HMI feeders
	        #HMI_FEEDER_OPEN[#i] := (#FEEDER_STATE[#i] = 0);
	        #HMI_FEEDER_CLOSED[#i] := (#FEEDER_STATE[#i] = 1);
	        #HMI_FEEDER_TRIPPED[#i] := #FEEDER_TRIPPED[#i];
	        #HMI_FEEDER_ALARM[#i] := #FEEDER_ALARM[#i];
	    END_FOR;
	    
	    
	    // ========================================================================
	    // NETWORK 5: DETECCIÓN Y GESTIÓN DE ALARMAS
	    // ========================================================================
	    
	    // Alarma activa si hay falla, violación enclavamiento, o alarma GD
	    #alarmActive := #IS_FAULT OR #ALM_INTERLOCK_VIOLATION OR #GD_ALARM OR #GD2_ALARM;
	    
	    // Texto alarma (prioridad descendente)
	    IF #IS_FAULT THEN
	        CASE #FAULT_CODE OF
	            101:
	                #alarmText := 'TIMEOUT: No se pudo abrir QT1';
	            102:
	                #alarmText := 'TIMEOUT: GD no alcanzó estado READY';
	            103:
	                #alarmText := 'TIMEOUT: No se pudo cerrar QG1';
	            104:
	                #alarmText := 'TIMEOUT: No se pudo abrir QG1';
	            105:
	                #alarmText := 'TIMEOUT: No se pudo cerrar QT1';
	            106:
	                #alarmText := 'ALARMA: Falla en Grupo Diésel';
	            107:
	                #alarmText := 'ALARMA: Violación enclavamiento fuente única';
	            108:
	                #alarmText := 'FALLA: Estado máquina desconocido';
	            ELSE
	                #alarmText := 'FALLA: Código desconocido';
	        END_CASE;
	    ELSIF #ALM_INTERLOCK_VIOLATION THEN
	        #alarmText := 'ALARMA: Múltiples fuentes cerradas simultáneamente';
	    ELSIF #GD_ALARM THEN
	        #alarmText := 'ALARMA: Falla en Grupo Diésel 1';
	    ELSIF #GD2_ALARM THEN
	        #alarmText := 'ALARMA: Falla en Grupo Diésel 2';
	    ELSE
	        #alarmText := '';
	    END_IF;
	    
	    // Reconocimiento alarma (R_TRIG)
	    #rtAckAlarm := #ACK_ALARM AND NOT #memAckAlarm;
	    #memAckAlarm := #ACK_ALARM;
	    
	    IF #rtAckAlarm THEN
	        #alarmAcknowledged := TRUE;
	    END_IF;
	    
	    // Reset acknowledged si desaparece alarma
	    IF NOT #alarmActive THEN
	        #alarmAcknowledged := FALSE;
	    END_IF;
	    
	    
	    // ========================================================================
	    // NETWORK 6: BALIZA
	    // ========================================================================
	    
	    // Baliza: activa si hay alarma (independiente de ACK)
	    #DO_ALARM_BEACON := #alarmActive;
	    
	    
	    // ========================================================================
	    // NETWORK 7: SEÑALES HMI GENERALES
	    // ========================================================================
	    
	    // Texto estado
	    #HMI_STATUS_TEXT := #STATE_NAME;
	    
	    // Alarma activa para HMI
	    #HMI_ALARM_ACTIVE := #alarmActive;
	    #HMI_ALARM_TEXT := #alarmText;
	    
END_FUNCTION_BLOCK

